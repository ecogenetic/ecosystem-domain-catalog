# LLM (optional OpenAI-compatible endpoint). Leave empty to keep graph-only mode.
# Primary names (preferred):
ECOSYSTEM_LLM_BASE_URL=
ECOSYSTEM_LLM_MODEL=
ECOSYSTEM_LLM_API_KEY=
# Aliases accepted by the client (same as ecosystem-server docker-compose CHAT_*):
# CHAT_SERVER=https://api.ecosystem.ai
# CHAT_SERVER_MODEL=qwen3.6:35b-a3b-coding-nvfp4
# CHAT_SERVER_KEY=

# Catalog location (defaults to the parent of this agents/ folder)
CATALOG_ROOT=

# Public UI origins in addition to localhost (comma-separated)
AGENTS_CORS_ORIGINS=

# HTTP — one gateway for Catalog + Data
AGENTS_PORT=8080
CATALOG_AGENT_PORT=8081
DATA_AGENT_PORT=8082

# Optional live databases (examples only)
# mongodb://localhost:27017  database mydb
# postgresql://user:pass@localhost:5432/mydb
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=mydb

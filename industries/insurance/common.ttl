@prefix : <https://ecosystemcode.com/ontology/industry/insurance#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/BFO_> .

<https://ecosystemcode.com/ontology/industry/insurance> a owl:Ontology ;
    rdfs:label "Insurance Industry Common Concepts" ;
    rdfs:comment "Shared insurance concepts reused across domain overlays: policies, claims, policyholders, and distribution roles." .

:Policy a owl:Class ;
    skos:prefLabel "Policy" ;
    skos:altLabel "Insurance Contract", "Cover" ;
    skos:definition "A contract of insurance defining cover, premium, term, and exclusions." .

:Policyholder a owl:Class ;
    skos:prefLabel "Policyholder" ;
    skos:altLabel "Insured Party", "Policy Owner" ;
    skos:definition "The party who owns an insurance policy and pays its premium." .

:Claim a owl:Class ;
    skos:prefLabel "Claim" ;
    skos:altLabel "Loss Event", "Insurance Claim" ;
    skos:definition "A demand for payment under a policy following an insured event." .

:Cover a owl:Class ;
    skos:prefLabel "Cover" ;
    skos:altLabel "Benefit" ;
    skos:definition "A versioned promise of protection with limits, conditions and exclusions under a policy." .

:InsuredRisk a owl:Class ;
    skos:prefLabel "Insured Risk" ;
    skos:definition "The person, asset, liability or event exposure protected by cover." .

:ClaimItem a owl:Class ;
    skos:prefLabel "Claim Item" ;
    skos:definition "An individually assessed component of a claim with its own amount and decision." .

:ClaimReserve a owl:Class ;
    skos:prefLabel "Claim Reserve" ;
    skos:definition "The estimated outstanding liability held for a claim at a point in time." .

:policyHeldByPolicyholder a owl:ObjectProperty ;
    rdfs:label "policy held by policyholder" ;
    rdfs:domain :Policy ;
    rdfs:range  :Policyholder ;
    skos:definition "Links a policy to the party who owns it." .

:claimAgainstPolicy a owl:ObjectProperty ;
    rdfs:label "claim against policy" ;
    rdfs:domain :Claim ;
    rdfs:range  :Policy ;
    skos:definition "The policy a claim draws against." .

:policyProvidesCover a owl:ObjectProperty ;
    rdfs:domain :Policy ;
    rdfs:range :Cover .

:coverProtectsRisk a owl:ObjectProperty ;
    rdfs:domain :Cover ;
    rdfs:range :InsuredRisk .

:claimHasItem a owl:ObjectProperty ;
    rdfs:domain :Claim ;
    rdfs:range :ClaimItem .

:reserveForClaim a owl:ObjectProperty ;
    rdfs:domain :ClaimReserve ;
    rdfs:range :Claim .

:claimStatus a owl:DatatypeProperty ;
    rdfs:label "claim status" ;
    rdfs:domain :Claim ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state: notified, assessed, approved, settled, repudiated." .

:UnderwriterRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Underwriter" ;
    skos:definition "Person role that assesses risk and prices cover. Bearer: person. Permissions: Policy:read, Policy:write." .

:ClaimsAssessorRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Claims Assessor" ;
    skos:altLabel "Loss Adjuster" ;
    skos:definition "Person role that investigates and adjudicates claims. Bearer: person. Permissions: Claim:read, Claim:write, Policy:read." .

:BrokerRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Broker" ;
    skos:altLabel "Agent", "Intermediary" ;
    skos:definition "Organisation role that distributes policies on behalf of insurers. Bearer: organisation. Permissions: Policy:read, Policyholder:read." .

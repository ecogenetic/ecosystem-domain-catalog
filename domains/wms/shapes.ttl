@prefix :    <https://ecosystemcode.com/ontology/wms#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:WarehouseShape a sh:NodeShape ;
    sh:targetClass :Warehouse ;
    sh:property [
        sh:path :warehouseCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

:BinLocationShape a sh:NodeShape ;
    sh:targetClass :BinLocation ;
    sh:property [
        sh:path :binCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

:StockLevelShape a sh:NodeShape ;
    sh:targetClass :StockLevel ;
    sh:property [
        sh:path :measuredAtBinLocation ;
        sh:class :BinLocation ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :itemCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :quantity ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
    ] .

:ReceiptShape a sh:NodeShape ;
    sh:targetClass :Receipt ;
    sh:property [
        sh:path :increasesStockLevel ;
        sh:class :StockLevel ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :receiptNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

:PickListShape a sh:NodeShape ;
    sh:targetClass :PickList ;
    sh:property [
        sh:path :reservesStockLevel ;
        sh:class :StockLevel ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :pickListNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :pickListStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "created" "in progress" "completed" "shipped" ) ;
    ] .

:ShipmentShape a sh:NodeShape ;
    sh:targetClass :Shipment ;
    sh:property [
        sh:path :fulfillsPickList ;
        sh:class :PickList ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :shipmentNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

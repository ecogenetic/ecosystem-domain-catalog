@prefix :     <https://ecosystemcode.com/ontology/tre/banking#> .
@prefix base: <https://ecosystemcode.com/ontology/tre#> .
@prefix bank: <https://ecosystemcode.com/ontology/industry/banking#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/BFO_> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .

<https://ecosystemcode.com/ontology/tre/banking> a owl:Ontology ;
    rdfs:label "TRE Banking Overlay" ;
    rdfs:comment "Additive banking specialization for the TRE domain." .

:RegulatoryLiquidityBuffer a owl:Class ;
    rdfs:subClassOf base:LiquidityBuffer ;
    skos:prefLabel "Regulatory Liquidity Buffer" ;
    skos:altLabel "Liquidity Coverage Buffer" ;
    skos:definition "A liquidity buffer classified for regulatory liquidity reporting." .

:DepositFundingSource a owl:Class ;
    rdfs:subClassOf base:FundingSource ;
    skos:prefLabel "Deposit Funding Source" ;
    skos:altLabel "Customer Deposit Funding" ;
    skos:definition "A funding source derived from customer deposit balances." .

:LiquidityStressScenario a owl:Class ;
    skos:prefLabel "Liquidity Stress Scenario" ;
    skos:altLabel "Liquidity Stress Test" ;
    skos:definition "A named scenario used to assess liquidity resilience." .

:derivedFromAccount a owl:ObjectProperty ;
    rdfs:label "derived from account" ;
    rdfs:domain :DepositFundingSource ;
    rdfs:range bank:FinancialAccount ;
    skos:definition "The customer financial account whose balances contribute to this deposit funding source." .

:reportedUnderScenario a owl:ObjectProperty ;
    rdfs:label "reported under scenario" ;
    rdfs:domain :RegulatoryLiquidityBuffer ;
    rdfs:range :LiquidityStressScenario ;
    skos:definition "The liquidity stress scenario under which the buffer is reported." .

:scenarioName a owl:DatatypeProperty ;
    rdfs:label "scenario name" ;
    rdfs:domain :LiquidityStressScenario ;
    rdfs:range xsd:string .

:AssetLiabilityCommitteeRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Asset Liability Committee Role" ;
    skos:altLabel "ALCO" ;
    skos:definition "Organisation role that reviews liquidity, funding, interest-rate risk, and transfer-pricing policy. Bearer: organisation." .

:LiquidityStressScenarioShape a sh:NodeShape ;
    sh:targetClass :LiquidityStressScenario ;
    sh:property [ sh:path :scenarioName ; sh:datatype xsd:string ; sh:minCount 1 ] .

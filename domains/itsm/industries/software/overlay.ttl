@prefix :    <https://ecosystemcode.com/ontology/itsm/software#> .
@prefix base: <https://ecosystemcode.com/ontology/itsm#> .
@prefix sw:  <https://ecosystemcode.com/ontology/industry/software#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .

<https://ecosystemcode.com/ontology/itsm/software> a owl:Ontology ;
    rdfs:label "ITSM Software Overlay" ;
    rdfs:comment "Software-company specialization of ITSM." .

:ProductionIncident a owl:Class ;
    rdfs:subClassOf base:Incident ;
    skos:prefLabel "Production Incident" ;
    skos:definition "An incident affecting a production software service." .

:SoftwareConfigurationItem a owl:Class ;
    rdfs:subClassOf base:ConfigurationItem ;
    skos:prefLabel "Software Configuration Item" ;
    skos:definition "A configuration item that represents a deployed software component." .

:affectsSoftwareConfigurationItem a owl:ObjectProperty ;
    rdfs:label "affects software configuration item" ;
    rdfs:domain :ProductionIncident ;
    rdfs:range :SoftwareConfigurationItem ;
    skos:definition "Associates production incident with SoftwareConfigurationItem." .

:productionIncidentId a owl:DatatypeProperty ;
    rdfs:label "production incident id" ;
    rdfs:domain :ProductionIncident ;
    rdfs:range xsd:string .

:softwareConfigurationItemId a owl:DatatypeProperty ;
    rdfs:label "software configuration item id" ;
    rdfs:domain :SoftwareConfigurationItem ;
    rdfs:range xsd:string .

:SoftwareChangeManagerRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Software Change Manager" ;
    skos:altLabel "Software Change Manager Role" ;
    skos:definition "Approves changes to production software configuration items. Bearer: person. Permissions: Incident:read, ChangeRequest:read, ChangeRequest:write, ConfigurationItem:read." .

:ProductionIncidentShape a sh:NodeShape ;
    sh:targetClass :ProductionIncident ;
    sh:property [
        sh:path :productionIncidentId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

#################################################################
# Roles (BFO role branch — bearer and permissions in the definition)
#################################################################

:BuyerRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Buyer" ;
    skos:altLabel "Procurement Officer", "Purchasing Agent" ;
    skos:definition "Person role that creates requisitions and purchase orders and selects vendors. Bearer: person. Permissions: PurchaseOrder:read, PurchaseOrder:write, Vendor:read, Product:read." .

:FinanceClerkRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Finance Clerk" ;
    skos:altLabel "Accounts Payable Clerk" ;
    skos:definition "Person role that three-way matches vendor invoices, runs payments, and posts entries to the ledger. Bearer: person. Permissions: Invoice:read, Invoice:write, Payment:read, Payment:write, Ledger:read, Ledger:write, JournalEntry:read, JournalEntry:write, PurchaseOrder:read, GoodsReceipt:read." .

:ApproverRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Approver" ;
    skos:altLabel "Purchase Approver" ;
    skos:definition "Person role that reviews and approves requisitions and purchase orders before commitment. Bearer: person. Permissions: Requisition:read, Requisition:write, PurchaseOrder:read, PurchaseOrder:write, Vendor:read." .

:WarehouseOperatorRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Warehouse Operator" ;
    skos:altLabel "Storekeeper", "Receiving Clerk" ;
    skos:definition "Person role that receives goods against purchase orders, picks and ships sales orders, and records stock movements. Bearer: person. Permissions: GoodsReceipt:read, GoodsReceipt:write, Shipment:read, Shipment:write, StockMovement:read, StockMovement:write, InventoryLevel:read, PurchaseOrder:read, SalesOrder:read." .

:SalesClerkRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Sales Clerk" ;
    skos:altLabel "Order Entry Clerk", "Customer Service Representative" ;
    skos:definition "Person role that captures sales orders, allocates stock, and issues customer invoices. Bearer: person. Permissions: SalesOrder:read, SalesOrder:write, CustomerInvoice:read, CustomerInvoice:write, Customer:read, Product:read, InventoryLevel:read." .

:ControllerRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Controller" ;
    skos:altLabel "Financial Controller", "Chief Accountant" ;
    skos:definition "Person role that manages the chart of accounts, opens and closes fiscal periods, monitors budgets, and signs off period-end close. Bearer: person. Permissions: GLAccount:read, GLAccount:write, FiscalPeriod:read, FiscalPeriod:write, Budget:read, Budget:write, JournalEntry:read, Ledger:read, CostCenter:read, CostCenter:write." .

@prefix :    <https://ecosystemcode.com/ontology/ecom/software#> .
@prefix base: <https://ecosystemcode.com/ontology/ecom#> .
@prefix sw:  <https://ecosystemcode.com/ontology/industry/software#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .

<https://ecosystemcode.com/ontology/ecom/software> a owl:Ontology ;
    rdfs:label "ECOM Software Overlay" ;
    rdfs:comment "Software-company specialization of ECOM." .

:DigitalProductOrder a owl:Class ;
    rdfs:subClassOf base:Order ;
    skos:prefLabel "Digital Product Order" ;
    skos:definition "An order for a software product rather than a shipped good." .

:SoftwareFulfilment a owl:Class ;
    rdfs:subClassOf base:Fulfilment ;
    skos:prefLabel "Software Fulfilment" ;
    skos:definition "Fulfilment that provisions access instead of shipping a parcel." .

:fulfilsDigitalProductOrder a owl:ObjectProperty ;
    rdfs:label "fulfils digital product order" ;
    rdfs:domain :SoftwareFulfilment ;
    rdfs:range :DigitalProductOrder ;
    skos:definition "Associates software fulfilment with DigitalProductOrder." .

:digitalProductOrderId a owl:DatatypeProperty ;
    rdfs:label "digital product order id" ;
    rdfs:domain :DigitalProductOrder ;
    rdfs:range xsd:string .

:softwareFulfilmentId a owl:DatatypeProperty ;
    rdfs:label "software fulfilment id" ;
    rdfs:domain :SoftwareFulfilment ;
    rdfs:range xsd:string .

:DigitalStoreAdministratorRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Digital Store Administrator" ;
    skos:altLabel "Digital Store Administrator Role" ;
    skos:definition "Oversees digital software orders and provisioning fulfilment. Bearer: person. Permissions: Order:read, Order:write, Fulfilment:read, Fulfilment:write." .

:DigitalProductOrderShape a sh:NodeShape ;
    sh:targetClass :DigitalProductOrder ;
    sh:property [
        sh:path :digitalProductOrderId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

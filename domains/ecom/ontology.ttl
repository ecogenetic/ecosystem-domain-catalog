@prefix : <https://ecosystemcode.com/ontology/ecom#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/BFO_> .

<https://ecosystemcode.com/ontology/ecom> a owl:Ontology ;
    rdfs:label "E-Commerce Domain Ontology" ;
    rdfs:comment "Seed ontology for digital commerce: products, carts, orders, payments, reviews, and fulfilment." .

#################################################################
# Classes
#################################################################

:Product a owl:Class ;
    skos:prefLabel "Product" ;
    skos:altLabel "Item", "SKU", "Listing" ;
    skos:definition "A sellable item with price, description, and stock availability." .

:Cart a owl:Class ;
    skos:prefLabel "Cart" ;
    skos:altLabel "Basket", "Shopping Cart" ;
    skos:definition "The shopper's working collection of products before checkout." .

:Order a owl:Class ;
    skos:prefLabel "Order" ;
    skos:altLabel "Purchase", "Sales Order" ;
    skos:definition "A confirmed purchase created from a cart at checkout." .

:Payment a owl:Class ;
    skos:prefLabel "Payment" ;
    skos:altLabel "Settlement", "Transaction" ;
    skos:definition "The settlement of an order through a payment method." .

:Review a owl:Class ;
    skos:prefLabel "Review" ;
    skos:altLabel "Rating", "Product Review" ;
    skos:definition "A shopper's rating and commentary about a product." .

:Fulfilment a owl:Class ;
    skos:prefLabel "Fulfilment" ;
    skos:altLabel "Fulfillment", "Shipment" ;
    skos:definition "The picking, packing, shipping, and delivery of an order." .

:Customer a owl:Class ;
    skos:prefLabel "Customer" ;
    skos:altLabel "Shopper", "Registered User" ;
    skos:definition "The registered shopper who owns carts, places orders, and writes reviews." .

:Category a owl:Class ;
    skos:prefLabel "Category" ;
    skos:altLabel "Product Category", "Collection" ;
    skos:definition "A named grouping that organises the catalog for browsing; categories can nest." .

:OrderLine a owl:Class ;
    skos:prefLabel "Order Line" ;
    skos:altLabel "Line Item", "Order Item" ;
    skos:definition "One product within an order with its quantity, unit price, and line total." .

:Promotion a owl:Class ;
    skos:prefLabel "Promotion" ;
    skos:altLabel "Discount", "Promo Code", "Offer" ;
    skos:definition "A discount or promotional offer applied to an order at checkout via a code or rule." .

#################################################################
# Object properties
#################################################################

:containsProduct a owl:ObjectProperty ;
    rdfs:label "contains product" ;
    rdfs:domain :Cart ;
    rdfs:range  :Product ;
    skos:definition "A product currently in the shopper's cart." .

:createdFromCart a owl:ObjectProperty ;
    rdfs:label "created from cart" ;
    rdfs:domain :Order ;
    rdfs:range  :Cart ;
    skos:definition "The cart this order was checked out from." .

:settlesOrder a owl:ObjectProperty ;
    rdfs:label "settles order" ;
    rdfs:domain :Payment ;
    rdfs:range  :Order ;
    skos:definition "The order this payment settles." .

:shipsOrder a owl:ObjectProperty ;
    rdfs:label "ships order" ;
    rdfs:domain :Fulfilment ;
    rdfs:range  :Order ;
    skos:definition "The order this fulfilment delivers." .

:writtenAboutProduct a owl:ObjectProperty ;
    rdfs:label "written about product" ;
    rdfs:domain :Review ;
    rdfs:range  :Product ;
    skos:definition "The product the review describes." .

:ownedByCustomer a owl:ObjectProperty ;
    rdfs:label "owned by customer" ;
    rdfs:domain :Cart ;
    rdfs:range  :Customer ;
    skos:definition "The customer whose working cart this is." .

:placedByCustomer a owl:ObjectProperty ;
    rdfs:label "placed by customer" ;
    rdfs:domain :Order ;
    rdfs:range  :Customer ;
    skos:definition "The customer who placed the order." .

:partOfOrder a owl:ObjectProperty ;
    rdfs:label "part of order" ;
    rdfs:domain :OrderLine ;
    rdfs:range  :Order ;
    skos:definition "The order this line belongs to." .

:forProduct a owl:ObjectProperty ;
    rdfs:label "for product" ;
    rdfs:domain :OrderLine ;
    rdfs:range  :Product ;
    skos:definition "The product this order line purchases." .

:inCategory a owl:ObjectProperty ;
    rdfs:label "in category" ;
    rdfs:domain :Product ;
    rdfs:range  :Category ;
    skos:definition "A category the product is listed under for browsing." .

:appliedToOrder a owl:ObjectProperty ;
    rdfs:label "applied to order" ;
    rdfs:domain :Promotion ;
    rdfs:range  :Order ;
    skos:definition "An order this promotion discounted at checkout." .

:writtenByCustomer a owl:ObjectProperty ;
    rdfs:label "written by customer" ;
    rdfs:domain :Review ;
    rdfs:range  :Customer ;
    skos:definition "The customer who wrote the review." .

#################################################################
# Datatype properties
#################################################################

:productName a owl:DatatypeProperty ;
    rdfs:label "product name" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:string .

:price a owl:DatatypeProperty ;
    rdfs:label "price" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:decimal .

:stockAvailable a owl:DatatypeProperty ;
    rdfs:label "stock available" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:integer .

:cartTotal a owl:DatatypeProperty ;
    rdfs:label "cart total" ;
    rdfs:domain :Cart ;
    rdfs:range  xsd:decimal .

:orderNumber a owl:DatatypeProperty ;
    rdfs:label "order number" ;
    rdfs:domain :Order ;
    rdfs:range  xsd:string .

:orderStatus a owl:DatatypeProperty ;
    rdfs:label "order status" ;
    rdfs:domain :Order ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the order: cart, paid, fulfilled, delivered." .

:orderTotal a owl:DatatypeProperty ;
    rdfs:label "order total" ;
    rdfs:domain :Order ;
    rdfs:range  xsd:decimal .

:paymentMethod a owl:DatatypeProperty ;
    rdfs:label "payment method" ;
    rdfs:domain :Payment ;
    rdfs:range  xsd:string .

:paidAmount a owl:DatatypeProperty ;
    rdfs:label "paid amount" ;
    rdfs:domain :Payment ;
    rdfs:range  xsd:decimal .

:rating a owl:DatatypeProperty ;
    rdfs:label "rating" ;
    rdfs:domain :Review ;
    rdfs:range  xsd:integer .

:trackingNumber a owl:DatatypeProperty ;
    rdfs:label "tracking number" ;
    rdfs:domain :Fulfilment ;
    rdfs:range  xsd:string .

:customerName a owl:DatatypeProperty ;
    rdfs:label "customer name" ;
    rdfs:domain :Customer ;
    rdfs:range  xsd:string .

:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:domain :Customer ;
    rdfs:range  xsd:string .

:productType a owl:DatatypeProperty ;
    rdfs:label "product type" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:string ;
    skos:definition "The kind of sellable: physical, digital, service, subscription." .

:categoryName a owl:DatatypeProperty ;
    rdfs:label "category name" ;
    rdfs:domain :Category ;
    rdfs:range  xsd:string .

:quantity a owl:DatatypeProperty ;
    rdfs:label "quantity" ;
    rdfs:domain :OrderLine ;
    rdfs:range  xsd:integer .

:unitPrice a owl:DatatypeProperty ;
    rdfs:label "unit price" ;
    rdfs:domain :OrderLine ;
    rdfs:range  xsd:decimal .

:lineTotal a owl:DatatypeProperty ;
    rdfs:label "line total" ;
    rdfs:domain :OrderLine ;
    rdfs:range  xsd:decimal .

:promoCode a owl:DatatypeProperty ;
    rdfs:label "promo code" ;
    rdfs:domain :Promotion ;
    rdfs:range  xsd:string .

:discountValue a owl:DatatypeProperty ;
    rdfs:label "discount value" ;
    rdfs:domain :Promotion ;
    rdfs:range  xsd:decimal .

:fulfilmentType a owl:DatatypeProperty ;
    rdfs:label "fulfilment type" ;
    rdfs:domain :Fulfilment ;
    rdfs:range  xsd:string ;
    skos:definition "How the order is delivered: shipping, digital-delivery, provisioning, pickup." .

#################################################################
# Roles (BFO role branch)
#################################################################

:ShopperRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Shopper" ;
    skos:altLabel "Customer", "Buyer" ;
    skos:definition "Person role that browses products, manages a cart, places orders, and writes reviews. Bearer: person. Permissions: Product:read, Cart:read, Cart:write, Order:read, Review:read, Review:write." .

:StoreAdministratorRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Store Administrator" ;
    skos:altLabel "Merchant Admin", "Shop Manager" ;
    skos:definition "Person role that maintains the catalog, monitors orders, and manages fulfilment. Bearer: person. Permissions: Product:read, Product:write, Order:read, Order:write, Fulfilment:read, Fulfilment:write." .

@prefix : <https://ecosystemcode.com/ontology/cvm#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/BFO_> .

<https://ecosystemcode.com/ontology/cvm> a owl:Ontology ;
    rdfs:label "CVM Domain Ontology" ;
    rdfs:comment "Seed ontology for Customer Value Management: customers, segments, value/churn/propensity scoring, products and price plans, next-best-action decisioning, treatments, channels, campaigns, and uplift measurement." .

#################################################################
# Classes
#################################################################

:Customer a owl:Class ;
    skos:prefLabel "Customer" ;
    skos:altLabel "Client", "Subscriber", "Member" ;
    skos:definition "A person or organisation whose value and behaviour the business manages." .

:Segment a owl:Class ;
    skos:prefLabel "Segment" ;
    skos:altLabel "Customer Segment", "Audience" ;
    skos:definition "A defined group of customers sharing value, behaviour, or risk characteristics." .

:ValueScore a owl:Class ;
    skos:prefLabel "Value Score" ;
    skos:altLabel "CLV Score", "Lifetime Value Score" ;
    skos:definition "A computed measure of a customer's current and predicted lifetime value." .

:ChurnRisk a owl:Class ;
    skos:prefLabel "Churn Risk" ;
    skos:altLabel "Attrition Risk", "Lapse Risk" ;
    skos:definition "A computed probability that a customer will lapse or defect." .

:Offer a owl:Class ;
    skos:prefLabel "Offer" ;
    skos:altLabel "Incentive", "Promotion" ;
    skos:definition "An incentive such as a discount, upgrade, or reward designed to change customer behaviour." .

:Campaign a owl:Class ;
    skos:prefLabel "Campaign" ;
    skos:altLabel "Marketing Campaign", "Retention Campaign" ;
    skos:definition "A targeted delivery of offers to one or more segments with measured outcomes." .

:PropensityScore a owl:Class ;
    skos:prefLabel "Propensity Score" ;
    skos:altLabel "Buy Propensity", "Acceptance Likelihood" ;
    skos:definition "A computed likelihood that a customer accepts a specific offer or buys a specific product." .

:CustomerEvent a owl:Class ;
    skos:prefLabel "Customer Event" ;
    skos:altLabel "Behavioural Event", "Interaction Event", "Usage Event" ;
    skos:definition "A recorded behavioural signal (purchase, usage, complaint, channel visit) that feeds scoring models." .

:PredictiveModel a owl:Class ;
    skos:prefLabel "Predictive Model" ;
    skos:altLabel "Scoring Model", "ML Model" ;
    skos:definition "A versioned scoring model (value, churn, propensity) whose outputs drive targeting decisions." .

:Product a owl:Class ;
    skos:prefLabel "Product" ;
    skos:altLabel "Offering", "Catalog Item", "Service" ;
    skos:definition "A product or service in the commercial catalog whose uptake and margin the business manages." .

:PricePlan a owl:Class ;
    skos:prefLabel "Price Plan" ;
    skos:altLabel "Tariff", "Plan", "Subscription Tier" ;
    skos:definition "A priced commercial construct (tariff, subscription tier, fee structure) a customer can be on." .

:EligibilityRule a owl:Class ;
    skos:prefLabel "Eligibility Rule" ;
    skos:altLabel "Targeting Rule", "Qualification Rule" ;
    skos:definition "A rule constraining which customers or segments may receive a product, price plan, or offer." .

:NextBestAction a owl:Class ;
    skos:prefLabel "Next Best Action" ;
    skos:altLabel "NBA", "Next Best Offer", "Recommendation" ;
    skos:definition "The ranked recommendation of the most valuable treatment for one customer at a point in time." .

:Treatment a owl:Class ;
    skos:prefLabel "Treatment" ;
    skos:altLabel "Contact", "Offer Delivery", "Touch" ;
    skos:definition "One delivery of an offer to one customer through a channel, with a recorded response." .

:Channel a owl:Class ;
    skos:prefLabel "Channel" ;
    skos:altLabel "Contact Channel", "Delivery Channel" ;
    skos:definition "A delivery route (SMS, email, app, call center, web) with cost and consent characteristics." .

:ControlGroup a owl:Class ;
    skos:prefLabel "Control Group" ;
    skos:altLabel "Holdout Group", "Universal Control" ;
    skos:definition "A held-out subset of a campaign's target audience used to measure true uplift." .

#################################################################
# Object properties
#################################################################

:assignedToSegment a owl:ObjectProperty ;
    rdfs:label "assigned to segment" ;
    rdfs:domain :Customer ;
    rdfs:range  :Segment ;
    skos:definition "Places a customer into a segment." .

:scoresCustomer a owl:ObjectProperty ;
    rdfs:label "scores customer" ;
    rdfs:domain :ValueScore ;
    rdfs:range  :Customer ;
    skos:definition "The customer a value score was computed for." .

:assessesCustomer a owl:ObjectProperty ;
    rdfs:label "assesses customer" ;
    rdfs:domain :ChurnRisk ;
    rdfs:range  :Customer ;
    skos:definition "The customer a churn risk was assessed for." .

:targetedAtSegment a owl:ObjectProperty ;
    rdfs:label "targeted at segment" ;
    rdfs:domain :Offer ;
    rdfs:range  :Segment ;
    skos:definition "The segment an offer is designed for." .

:deliversOffer a owl:ObjectProperty ;
    rdfs:label "delivers offer" ;
    rdfs:domain :Campaign ;
    rdfs:range  :Offer ;
    skos:definition "The offer a campaign delivers to its target segments." .

:targetsSegment a owl:ObjectProperty ;
    rdfs:label "targets segment" ;
    rdfs:domain :Campaign ;
    rdfs:range  :Segment ;
    skos:definition "A segment the campaign is delivered to." .

:subscribedToPricePlan a owl:ObjectProperty ;
    rdfs:label "subscribed to price plan" ;
    rdfs:domain :Customer ;
    rdfs:range  :PricePlan ;
    skos:definition "The price plan the customer is currently on." .

:recordedForCustomer a owl:ObjectProperty ;
    rdfs:label "recorded for customer" ;
    rdfs:domain :CustomerEvent ;
    rdfs:range  :Customer ;
    skos:definition "The customer whose behaviour the event records." .

:estimatesCustomer a owl:ObjectProperty ;
    rdfs:label "estimates customer" ;
    rdfs:domain :PropensityScore ;
    rdfs:range  :Customer ;
    skos:definition "The customer a propensity score was estimated for." .

:estimatesForProduct a owl:ObjectProperty ;
    rdfs:label "estimates for product" ;
    rdfs:domain :PropensityScore ;
    rdfs:range  :Product ;
    skos:definition "The product the propensity score estimates uptake likelihood for." .

:producedByModel a owl:ObjectProperty ;
    rdfs:label "produced by model" ;
    rdfs:domain :ValueScore ;
    rdfs:range  :PredictiveModel ;
    skos:definition "The predictive model version that produced the value score." .

:computedByModel a owl:ObjectProperty ;
    rdfs:label "computed by model" ;
    rdfs:domain :ChurnRisk ;
    rdfs:range  :PredictiveModel ;
    skos:definition "The predictive model version that computed the churn risk." .

:generatedByModel a owl:ObjectProperty ;
    rdfs:label "generated by model" ;
    rdfs:domain :PropensityScore ;
    rdfs:range  :PredictiveModel ;
    skos:definition "The predictive model version that generated the propensity score." .

:pricesProduct a owl:ObjectProperty ;
    rdfs:label "prices product" ;
    rdfs:domain :PricePlan ;
    rdfs:range  :Product ;
    skos:definition "The products whose commercial terms the price plan defines." .

:restrictsOffer a owl:ObjectProperty ;
    rdfs:label "restricts offer" ;
    rdfs:domain :EligibilityRule ;
    rdfs:range  :Offer ;
    skos:definition "The offer whose audience the eligibility rule constrains." .

:appliesToSegment a owl:ObjectProperty ;
    rdfs:label "applies to segment" ;
    rdfs:domain :EligibilityRule ;
    rdfs:range  :Segment ;
    skos:definition "The segments an eligibility rule includes or excludes." .

:promotesProduct a owl:ObjectProperty ;
    rdfs:label "promotes product" ;
    rdfs:domain :Offer ;
    rdfs:range  :Product ;
    skos:definition "The products an offer incentivises the customer to take up." .

:recommendsOffer a owl:ObjectProperty ;
    rdfs:label "recommends offer" ;
    rdfs:domain :NextBestAction ;
    rdfs:range  :Offer ;
    skos:definition "The offer the next-best-action decision recommends." .

:recommendedForCustomer a owl:ObjectProperty ;
    rdfs:label "recommended for customer" ;
    rdfs:domain :NextBestAction ;
    rdfs:range  :Customer ;
    skos:definition "The customer the next best action was decided for." .

:deliversOfferToCustomer a owl:ObjectProperty ;
    rdfs:label "delivers offer to customer" ;
    rdfs:domain :Treatment ;
    rdfs:range  :Customer ;
    skos:definition "The customer who received the treatment." .

:executesOffer a owl:ObjectProperty ;
    rdfs:label "executes offer" ;
    rdfs:domain :Treatment ;
    rdfs:range  :Offer ;
    skos:definition "The offer the treatment delivered." .

:deliveredViaChannel a owl:ObjectProperty ;
    rdfs:label "delivered via channel" ;
    rdfs:domain :Treatment ;
    rdfs:range  :Channel ;
    skos:definition "The channel the treatment was delivered through." .

:partOfCampaign a owl:ObjectProperty ;
    rdfs:label "part of campaign" ;
    rdfs:domain :Treatment ;
    rdfs:range  :Campaign ;
    skos:definition "The campaign the treatment was executed under." .

:heldOutControlGroup a owl:ObjectProperty ;
    rdfs:label "held out control group" ;
    rdfs:domain :Campaign ;
    rdfs:range  :ControlGroup ;
    skos:definition "The control group withheld from the campaign to measure true uplift." .

#################################################################
# Datatype properties
#################################################################

:externalRef a owl:DatatypeProperty ;
    rdfs:label "external reference" ;
    rdfs:domain :Customer ;
    rdfs:range  xsd:string .

:consentToMarketing a owl:DatatypeProperty ;
    rdfs:label "consent to marketing" ;
    rdfs:domain :Customer ;
    rdfs:range  xsd:boolean .

:segmentName a owl:DatatypeProperty ;
    rdfs:label "segment name" ;
    rdfs:domain :Segment ;
    rdfs:range  xsd:string .

:criteria a owl:DatatypeProperty ;
    rdfs:label "criteria" ;
    rdfs:domain :Segment ;
    rdfs:range  xsd:string .

:scoreValue a owl:DatatypeProperty ;
    rdfs:label "score value" ;
    rdfs:domain :ValueScore ;
    rdfs:range  xsd:decimal .

:probability a owl:DatatypeProperty ;
    rdfs:label "probability" ;
    rdfs:domain :ChurnRisk ;
    rdfs:range  xsd:decimal .

:riskBand a owl:DatatypeProperty ;
    rdfs:label "risk band" ;
    rdfs:domain :ChurnRisk ;
    rdfs:range  xsd:string .

:offerName a owl:DatatypeProperty ;
    rdfs:label "offer name" ;
    rdfs:domain :Offer ;
    rdfs:range  xsd:string .

:incentiveType a owl:DatatypeProperty ;
    rdfs:label "incentive type" ;
    rdfs:domain :Offer ;
    rdfs:range  xsd:string .

:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until" ;
    rdfs:domain :Offer ;
    rdfs:range  xsd:date .

:campaignName a owl:DatatypeProperty ;
    rdfs:label "campaign name" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:string .

:campaignStatus a owl:DatatypeProperty ;
    rdfs:label "campaign status" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the campaign: draft, targeted, launched, measured, closed." .

:upliftMeasured a owl:DatatypeProperty ;
    rdfs:label "uplift measured" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:decimal .

:tenureMonths a owl:DatatypeProperty ;
    rdfs:label "tenure months" ;
    rdfs:domain :Customer ;
    rdfs:range  xsd:integer .

:currentMonthlySpend a owl:DatatypeProperty ;
    rdfs:label "current monthly spend" ;
    rdfs:domain :Customer ;
    rdfs:range  xsd:decimal .

:memberCount a owl:DatatypeProperty ;
    rdfs:label "member count" ;
    rdfs:domain :Segment ;
    rdfs:range  xsd:integer .

:propensityValue a owl:DatatypeProperty ;
    rdfs:label "propensity value" ;
    rdfs:domain :PropensityScore ;
    rdfs:range  xsd:decimal .

:scoredAt a owl:DatatypeProperty ;
    rdfs:label "scored at" ;
    rdfs:domain :PropensityScore ;
    rdfs:range  xsd:dateTime .

:targetAction a owl:DatatypeProperty ;
    rdfs:label "target action" ;
    rdfs:domain :PropensityScore ;
    rdfs:range  xsd:string ;
    skos:definition "The behaviour the propensity predicts: purchase, upgrade, accept-offer, renew." .

:eventType a owl:DatatypeProperty ;
    rdfs:label "event type" ;
    rdfs:domain :CustomerEvent ;
    rdfs:range  xsd:string ;
    skos:definition "Kind of behavioural event: purchase, usage, complaint, channel-visit, payment." .

:eventAt a owl:DatatypeProperty ;
    rdfs:label "event at" ;
    rdfs:domain :CustomerEvent ;
    rdfs:range  xsd:dateTime .

:eventValue a owl:DatatypeProperty ;
    rdfs:label "event value" ;
    rdfs:domain :CustomerEvent ;
    rdfs:range  xsd:decimal .

:modelName a owl:DatatypeProperty ;
    rdfs:label "model name" ;
    rdfs:domain :PredictiveModel ;
    rdfs:range  xsd:string .

:modelVersion a owl:DatatypeProperty ;
    rdfs:label "model version" ;
    rdfs:domain :PredictiveModel ;
    rdfs:range  xsd:string .

:modelType a owl:DatatypeProperty ;
    rdfs:label "model type" ;
    rdfs:domain :PredictiveModel ;
    rdfs:range  xsd:string ;
    skos:definition "Kind of model: value, churn, propensity, uplift." .

:trainedAt a owl:DatatypeProperty ;
    rdfs:label "trained at" ;
    rdfs:domain :PredictiveModel ;
    rdfs:range  xsd:dateTime .

:accuracy a owl:DatatypeProperty ;
    rdfs:label "accuracy" ;
    rdfs:domain :PredictiveModel ;
    rdfs:range  xsd:decimal .

:modelStatus a owl:DatatypeProperty ;
    rdfs:label "model status" ;
    rdfs:domain :PredictiveModel ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the predictive model: training, validated, deployed, retired." .

:productCode a owl:DatatypeProperty ;
    rdfs:label "product code" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:string .

:productName a owl:DatatypeProperty ;
    rdfs:label "product name" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:string .

:marginPercent a owl:DatatypeProperty ;
    rdfs:label "margin percent" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:decimal .

:planName a owl:DatatypeProperty ;
    rdfs:label "plan name" ;
    rdfs:domain :PricePlan ;
    rdfs:range  xsd:string .

:monthlyFee a owl:DatatypeProperty ;
    rdfs:label "monthly fee" ;
    rdfs:domain :PricePlan ;
    rdfs:range  xsd:decimal .

:contractMonths a owl:DatatypeProperty ;
    rdfs:label "contract months" ;
    rdfs:domain :PricePlan ;
    rdfs:range  xsd:integer .

:planStatus a owl:DatatypeProperty ;
    rdfs:label "plan status" ;
    rdfs:domain :PricePlan ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the price plan: draft, active, grandfathered, retired." .

:ruleName a owl:DatatypeProperty ;
    rdfs:label "rule name" ;
    rdfs:domain :EligibilityRule ;
    rdfs:range  xsd:string .

:ruleExpression a owl:DatatypeProperty ;
    rdfs:label "rule expression" ;
    rdfs:domain :EligibilityRule ;
    rdfs:range  xsd:string .

:rulePriority a owl:DatatypeProperty ;
    rdfs:label "rule priority" ;
    rdfs:domain :EligibilityRule ;
    rdfs:range  xsd:integer .

:offerCost a owl:DatatypeProperty ;
    rdfs:label "offer cost" ;
    rdfs:domain :Offer ;
    rdfs:range  xsd:decimal .

:expectedUplift a owl:DatatypeProperty ;
    rdfs:label "expected uplift" ;
    rdfs:domain :Offer ;
    rdfs:range  xsd:decimal .

:offerStatus a owl:DatatypeProperty ;
    rdfs:label "offer status" ;
    rdfs:domain :Offer ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the offer: designed, approved, active, expired, withdrawn." .

:rank a owl:DatatypeProperty ;
    rdfs:label "rank" ;
    rdfs:domain :NextBestAction ;
    rdfs:range  xsd:integer .

:expectedValue a owl:DatatypeProperty ;
    rdfs:label "expected value" ;
    rdfs:domain :NextBestAction ;
    rdfs:range  xsd:decimal .

:decidedAt a owl:DatatypeProperty ;
    rdfs:label "decided at" ;
    rdfs:domain :NextBestAction ;
    rdfs:range  xsd:dateTime .

:decisionReason a owl:DatatypeProperty ;
    rdfs:label "decision reason" ;
    rdfs:domain :NextBestAction ;
    rdfs:range  xsd:string .

:deliveredAt a owl:DatatypeProperty ;
    rdfs:label "delivered at" ;
    rdfs:domain :Treatment ;
    rdfs:range  xsd:dateTime .

:responseStatus a owl:DatatypeProperty ;
    rdfs:label "response status" ;
    rdfs:domain :Treatment ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the treatment: selected, delivered, responded, no_response, suppressed." .

:respondedAt a owl:DatatypeProperty ;
    rdfs:label "responded at" ;
    rdfs:domain :Treatment ;
    rdfs:range  xsd:dateTime .

:channelName a owl:DatatypeProperty ;
    rdfs:label "channel name" ;
    rdfs:domain :Channel ;
    rdfs:range  xsd:string .

:channelType a owl:DatatypeProperty ;
    rdfs:label "channel type" ;
    rdfs:domain :Channel ;
    rdfs:range  xsd:string ;
    skos:definition "Kind of channel: sms, email, app, call-center, web." .

:costPerContact a owl:DatatypeProperty ;
    rdfs:label "cost per contact" ;
    rdfs:domain :Channel ;
    rdfs:range  xsd:decimal .

:campaignBudget a owl:DatatypeProperty ;
    rdfs:label "campaign budget" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:decimal .

:holdoutPercent a owl:DatatypeProperty ;
    rdfs:label "holdout percent" ;
    rdfs:domain :ControlGroup ;
    rdfs:range  xsd:decimal .

:controlSize a owl:DatatypeProperty ;
    rdfs:label "control size" ;
    rdfs:domain :ControlGroup ;
    rdfs:range  xsd:integer .

#################################################################
# Roles (BFO role branch)
#################################################################

:MarketingAnalystRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Marketing Analyst" ;
    skos:altLabel "CVM Analyst", "Campaign Analyst" ;
    skos:definition "Person role that builds segments, designs offers, and configures campaigns. Bearer: person. Permissions: Segment:read, Segment:write, Offer:read, Offer:write, Campaign:read, Campaign:write." .

:RetentionManagerRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Retention Manager" ;
    skos:altLabel "Loyalty Manager" ;
    skos:definition "Person role that monitors churn risk and value trends and approves retention offers and campaigns. Bearer: person. Permissions: ChurnRisk:read, ValueScore:read, NextBestAction:read, Campaign:read, Campaign:write, Offer:read, Customer:read." .

:PricingManagerRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Pricing Manager" ;
    skos:altLabel "Commercial Manager", "Product Pricing Lead" ;
    skos:definition "Person role that owns the product and price-plan catalog, sets eligibility rules, and approves offer economics. Bearer: person. Permissions: Product:read, Product:write, PricePlan:read, PricePlan:write, EligibilityRule:read, EligibilityRule:write, Offer:read." .

:DataScientistRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Data Scientist" ;
    skos:altLabel "Decision Scientist", "ML Engineer" ;
    skos:definition "Person role that builds, validates, and deploys the scoring models behind value, churn, and propensity. Bearer: person. Permissions: PredictiveModel:read, PredictiveModel:write, ValueScore:read, ChurnRisk:read, PropensityScore:read, CustomerEvent:read." .

:CampaignOperatorRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Campaign Operator" ;
    skos:altLabel "Campaign Execution Specialist" ;
    skos:definition "Person role that executes launched campaigns across channels and monitors treatment delivery. Bearer: person. Permissions: Campaign:read, Treatment:read, Treatment:write, Channel:read, Offer:read, Customer:read." .

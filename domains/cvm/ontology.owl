<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#generatedByModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>generated by model</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PropensityScore"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#PredictiveModel"/>
    <skos:definition>The predictive model version that generated the propensity score.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#campaignBudget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>campaign budget</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Campaign"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#campaignStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>campaign status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Campaign"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the campaign: draft, targeted, launched, measured, closed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#costPerContact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>cost per contact</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Channel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#subscribedToPricePlan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>subscribed to price plan</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#PricePlan"/>
    <skos:definition>The price plan the customer is currently on.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#partOfCampaign">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>part of campaign</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Treatment"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Campaign"/>
    <skos:definition>The campaign the treatment was executed under.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#pricesProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>prices product</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PricePlan"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Product"/>
    <skos:definition>The products whose commercial terms the price plan defines.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#channelName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>channel name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Channel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#recommendsOffer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>recommends offer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#NextBestAction"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <skos:definition>The offer the next-best-action decision recommends.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#eventAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>event at</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#CustomerEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#productName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>product name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#eventType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>event type</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#CustomerEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Kind of behavioural event: purchase, usage, complaint, channel-visit, payment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#ruleName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>rule name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#EligibilityRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#expectedValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>expected value</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#NextBestAction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#monthlyFee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>monthly fee</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PricePlan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#EligibilityRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Eligibility Rule</skos:prefLabel>
    <skos:altLabel>Targeting Rule</skos:altLabel>
    <skos:altLabel>Qualification Rule</skos:altLabel>
    <skos:definition>A rule constraining which customers or segments may receive a product, price plan, or offer.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#appliesToSegment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>applies to segment</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#EligibilityRule"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Segment"/>
    <skos:definition>The segments an eligibility rule includes or excludes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#restrictsOffer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>restricts offer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#EligibilityRule"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <skos:definition>The offer whose audience the eligibility rule constrains.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#modelVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>model version</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PredictiveModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#PredictiveModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Predictive Model</skos:prefLabel>
    <skos:altLabel>Scoring Model</skos:altLabel>
    <skos:altLabel>ML Model</skos:altLabel>
    <skos:definition>A versioned scoring model (value, churn, propensity) whose outputs drive targeting decisions.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#offerCost">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>offer cost</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#campaignName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>campaign name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Campaign"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#targetedAtSegment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>targeted at segment</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Segment"/>
    <skos:definition>The segment an offer is designed for.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#propensityValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>propensity value</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PropensityScore"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#rulePriority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>rule priority</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#EligibilityRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#holdoutPercent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>holdout percent</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#ControlGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#recordedForCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>recorded for customer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#CustomerEvent"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <skos:definition>The customer whose behaviour the event records.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#Customer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Customer</skos:prefLabel>
    <skos:altLabel>Client</skos:altLabel>
    <skos:altLabel>Subscriber</skos:altLabel>
    <skos:altLabel>Member</skos:altLabel>
    <skos:definition>A person or organisation whose value and behaviour the business manages.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#Offer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Offer</skos:prefLabel>
    <skos:altLabel>Incentive</skos:altLabel>
    <skos:altLabel>Promotion</skos:altLabel>
    <skos:definition>An incentive such as a discount, upgrade, or reward designed to change customer behaviour.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#ValueScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Value Score</skos:prefLabel>
    <skos:altLabel>CLV Score</skos:altLabel>
    <skos:altLabel>Lifetime Value Score</skos:altLabel>
    <skos:definition>A computed measure of a customer's current and predicted lifetime value.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#riskBand">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>risk band</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#ChurnRisk"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#externalRef">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>external reference</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#Treatment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Treatment</skos:prefLabel>
    <skos:altLabel>Contact</skos:altLabel>
    <skos:altLabel>Offer Delivery</skos:altLabel>
    <skos:altLabel>Touch</skos:altLabel>
    <skos:definition>One delivery of an offer to one customer through a channel, with a recorded response.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#productCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>product code</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#targetsSegment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>targets segment</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Campaign"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Segment"/>
    <skos:definition>A segment the campaign is delivered to.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#DataScientistRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <skos:prefLabel>Data Scientist</skos:prefLabel>
    <skos:altLabel>Decision Scientist</skos:altLabel>
    <skos:altLabel>ML Engineer</skos:altLabel>
    <skos:definition>Person role that builds, validates, and deploys the scoring models behind value, churn, and propensity. Bearer: person. Permissions: PredictiveModel:read, PredictiveModel:write, ValueScore:read, ChurnRisk:read, PropensityScore:read, CustomerEvent:read.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#estimatesCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>estimates customer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PropensityScore"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <skos:definition>The customer a propensity score was estimated for.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#ChurnRisk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Churn Risk</skos:prefLabel>
    <skos:altLabel>Attrition Risk</skos:altLabel>
    <skos:altLabel>Lapse Risk</skos:altLabel>
    <skos:definition>A computed probability that a customer will lapse or defect.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#Product">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Product</skos:prefLabel>
    <skos:altLabel>Offering</skos:altLabel>
    <skos:altLabel>Catalog Item</skos:altLabel>
    <skos:altLabel>Service</skos:altLabel>
    <skos:definition>A product or service in the commercial catalog whose uptake and margin the business manages.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#decidedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>decided at</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#NextBestAction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#scoredAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>scored at</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PropensityScore"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#PricePlan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Price Plan</skos:prefLabel>
    <skos:altLabel>Tariff</skos:altLabel>
    <skos:altLabel>Plan</skos:altLabel>
    <skos:altLabel>Subscription Tier</skos:altLabel>
    <skos:definition>A priced commercial construct (tariff, subscription tier, fee structure) a customer can be on.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#assessesCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>assesses customer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#ChurnRisk"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <skos:definition>The customer a churn risk was assessed for.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#trainedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>trained at</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PredictiveModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#NextBestAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Next Best Action</skos:prefLabel>
    <skos:altLabel>NBA</skos:altLabel>
    <skos:altLabel>Next Best Offer</skos:altLabel>
    <skos:altLabel>Recommendation</skos:altLabel>
    <skos:definition>The ranked recommendation of the most valuable treatment for one customer at a point in time.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#MarketingAnalystRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <skos:prefLabel>Marketing Analyst</skos:prefLabel>
    <skos:altLabel>CVM Analyst</skos:altLabel>
    <skos:altLabel>Campaign Analyst</skos:altLabel>
    <skos:definition>Person role that builds segments, designs offers, and configures campaigns. Bearer: person. Permissions: Segment:read, Segment:write, Offer:read, Offer:write, Campaign:read, Campaign:write.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#recommendedForCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>recommended for customer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#NextBestAction"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <skos:definition>The customer the next best action was decided for.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#computedByModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>computed by model</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#ChurnRisk"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#PredictiveModel"/>
    <skos:definition>The predictive model version that computed the churn risk.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#deliversOfferToCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>delivers offer to customer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Treatment"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <skos:definition>The customer who received the treatment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#deliveredViaChannel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>delivered via channel</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Treatment"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Channel"/>
    <skos:definition>The channel the treatment was delivered through.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#scoresCustomer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>scores customer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#ValueScore"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <skos:definition>The customer a value score was computed for.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#rank">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>rank</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#NextBestAction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#channelType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>channel type</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Channel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Kind of channel: sms, email, app, call-center, web.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#PricingManagerRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <skos:prefLabel>Pricing Manager</skos:prefLabel>
    <skos:altLabel>Commercial Manager</skos:altLabel>
    <skos:altLabel>Product Pricing Lead</skos:altLabel>
    <skos:definition>Person role that owns the product and price-plan catalog, sets eligibility rules, and approves offer economics. Bearer: person. Permissions: Product:read, Product:write, PricePlan:read, PricePlan:write, EligibilityRule:read, EligibilityRule:write, Offer:read.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#PropensityScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Propensity Score</skos:prefLabel>
    <skos:altLabel>Buy Propensity</skos:altLabel>
    <skos:altLabel>Acceptance Likelihood</skos:altLabel>
    <skos:definition>A computed likelihood that a customer accepts a specific offer or buys a specific product.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#responseStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>response status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Treatment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the treatment: selected, delivered, responded, no_response, suppressed.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#eventValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>event value</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#CustomerEvent"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#planStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>plan status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PricePlan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the price plan: draft, active, grandfathered, retired.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#incentiveType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>incentive type</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#respondedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>responded at</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Treatment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#upliftMeasured">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>uplift measured</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Campaign"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#expectedUplift">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>expected uplift</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#Campaign">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Campaign</skos:prefLabel>
    <skos:altLabel>Marketing Campaign</skos:altLabel>
    <skos:altLabel>Retention Campaign</skos:altLabel>
    <skos:definition>A targeted delivery of offers to one or more segments with measured outcomes.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#currentMonthlySpend">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>current monthly spend</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#CustomerEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Customer Event</skos:prefLabel>
    <skos:altLabel>Behavioural Event</skos:altLabel>
    <skos:altLabel>Interaction Event</skos:altLabel>
    <skos:altLabel>Usage Event</skos:altLabel>
    <skos:definition>A recorded behavioural signal (purchase, usage, complaint, channel visit) that feeds scoring models.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#accuracy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>accuracy</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PredictiveModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#offerStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>offer status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the offer: designed, approved, active, expired, withdrawn.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#planName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>plan name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PricePlan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#modelName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>model name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PredictiveModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#modelType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>model type</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PredictiveModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Kind of model: value, churn, propensity, uplift.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#producedByModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>produced by model</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#ValueScore"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#PredictiveModel"/>
    <skos:definition>The predictive model version that produced the value score.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#marginPercent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>margin percent</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#contractMonths">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>contract months</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PricePlan"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#executesOffer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>executes offer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Treatment"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <skos:definition>The offer the treatment delivered.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#RetentionManagerRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <skos:prefLabel>Retention Manager</skos:prefLabel>
    <skos:altLabel>Loyalty Manager</skos:altLabel>
    <skos:definition>Person role that monitors churn risk and value trends and approves retention offers and campaigns. Bearer: person. Permissions: ChurnRisk:read, ValueScore:read, NextBestAction:read, Campaign:read, Campaign:write, Offer:read, Customer:read.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#scoreValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>score value</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#ValueScore"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#modelStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>model status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PredictiveModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the predictive model: training, validated, deployed, retired.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#offerName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>offer name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#Channel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Channel</skos:prefLabel>
    <skos:altLabel>Contact Channel</skos:altLabel>
    <skos:altLabel>Delivery Channel</skos:altLabel>
    <skos:definition>A delivery route (SMS, email, app, call center, web) with cost and consent characteristics.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#segmentName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>segment name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Segment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>CVM Domain Ontology</rdfs:label>
    <rdfs:comment>Seed ontology for Customer Value Management: customers, segments, value/churn/propensity scoring, products and price plans, next-best-action decisioning, treatments, channels, campaigns, and uplift measurement.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#promotesProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>promotes product</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Product"/>
    <skos:definition>The products an offer incentivises the customer to take up.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#decisionReason">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>decision reason</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#NextBestAction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#ControlGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Control Group</skos:prefLabel>
    <skos:altLabel>Holdout Group</skos:altLabel>
    <skos:altLabel>Universal Control</skos:altLabel>
    <skos:definition>A held-out subset of a campaign's target audience used to measure true uplift.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#estimatesForProduct">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>estimates for product</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PropensityScore"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Product"/>
    <skos:definition>The product the propensity score estimates uptake likelihood for.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#validUntil">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>valid until</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#assignedToSegment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>assigned to segment</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Segment"/>
    <skos:definition>Places a customer into a segment.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#deliversOffer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>delivers offer</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Campaign"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#Offer"/>
    <skos:definition>The offer a campaign delivers to its target segments.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#criteria">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>criteria</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Segment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#ruleExpression">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>rule expression</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#EligibilityRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#Segment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <skos:prefLabel>Segment</skos:prefLabel>
    <skos:altLabel>Customer Segment</skos:altLabel>
    <skos:altLabel>Audience</skos:altLabel>
    <skos:definition>A defined group of customers sharing value, behaviour, or risk characteristics.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#CampaignOperatorRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <skos:prefLabel>Campaign Operator</skos:prefLabel>
    <skos:altLabel>Campaign Execution Specialist</skos:altLabel>
    <skos:definition>Person role that executes launched campaigns across channels and monitors treatment delivery. Bearer: person. Permissions: Campaign:read, Treatment:read, Treatment:write, Channel:read, Offer:read, Customer:read.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#controlSize">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>control size</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#ControlGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#targetAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>target action</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#PropensityScore"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>The behaviour the propensity predicts: purchase, upgrade, accept-offer, renew.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#memberCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>member count</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Segment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#deliveredAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>delivered at</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Treatment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#consentToMarketing">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>consent to marketing</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#heldOutControlGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>held out control group</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/cvm#Campaign"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/cvm#ControlGroup"/>
    <skos:definition>The control group withheld from the campaign to measure true uplift.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://ecosystemcode.com/ontology/cvm#tenureMonths">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>

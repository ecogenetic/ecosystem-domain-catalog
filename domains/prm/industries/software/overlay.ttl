@prefix :    <https://ecosystemcode.com/ontology/prm/software#> .
@prefix base: <https://ecosystemcode.com/ontology/prm#> .
@prefix sw:  <https://ecosystemcode.com/ontology/industry/software#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .

<https://ecosystemcode.com/ontology/prm/software> a owl:Ontology ;
    rdfs:label "PRM Software Overlay" ;
    rdfs:comment "Software-company specialization of PRM." .

:MarketplacePartner a owl:Class ;
    rdfs:subClassOf base:Partner ;
    skos:prefLabel "Marketplace Partner" ;
    skos:definition "A partner that lists or integrates a software product." .

:IntegrationAgreement a owl:Class ;
    rdfs:subClassOf base:PartnerAgreement ;
    skos:prefLabel "Integration Agreement" ;
    skos:definition "An agreement that allows a partner to call or embed a product." .

:governsMarketplacePartner a owl:ObjectProperty ;
    rdfs:label "governs marketplace partner" ;
    rdfs:domain :IntegrationAgreement ;
    rdfs:range :MarketplacePartner ;
    skos:definition "Associates integration agreement with MarketplacePartner." .

:marketplacePartnerId a owl:DatatypeProperty ;
    rdfs:label "marketplace partner id" ;
    rdfs:domain :MarketplacePartner ;
    rdfs:range xsd:string .

:integrationAgreementId a owl:DatatypeProperty ;
    rdfs:label "integration agreement id" ;
    rdfs:domain :IntegrationAgreement ;
    rdfs:range xsd:string .

:TechnologyPartnerManagerRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Technology Partner Manager" ;
    skos:altLabel "Technology Partner Manager Role" ;
    skos:definition "Onboards marketplace partners and integration agreements. Bearer: person. Permissions: Partner:read, Partner:write, PartnerAgreement:read, PartnerAgreement:write." .

:MarketplacePartnerShape a sh:NodeShape ;
    sh:targetClass :MarketplacePartner ;
    sh:property [
        sh:path :marketplacePartnerId ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

# Generic telco source mapping for the CRM telecommunications overlay
# Operational records remain mastered by their source domains; this mapping
# exposes CRM relationships, journeys, cases, and traceable references.

@prefix telcrm: <https://ecosystemcode.com/ontology/crm/telco#> .
@prefix crm:    <https://ecosystemcode.com/ontology/crm#> .
@prefix sub:    <https://ecosystemcode.com/ontology/sub#> .
@prefix bil:    <https://ecosystemcode.com/ontology/bil#> .
@prefix chg:    <https://ecosystemcode.com/ontology/chg#> .
@prefix num:    <https://ecosystemcode.com/ontology/num#> .
@prefix siv:    <https://ecosystemcode.com/ontology/siv#> .
@prefix prv:    <https://ecosystemcode.com/ontology/prv#> .
@prefix sam:    <https://ecosystemcode.com/ontology/sam#> .
@prefix raf:    <https://ecosystemcode.com/ontology/raf#> .
@prefix prm:    <https://ecosystemcode.com/ontology/prm#> .
@prefix wsp:    <https://ecosystemcode.com/ontology/wsp#> .
@prefix cvm:    <https://ecosystemcode.com/ontology/cvm#> .
@prefix legacy: <https://example.com/legacy/telco-crm#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .

#################################################################
# CRM-facing class mappings
#################################################################

legacy:customer_parties owl:equivalentClass telcrm:CustomerParty .
legacy:authorised_contacts owl:equivalentClass telcrm:AuthorisedContact .
legacy:subscriber_relationships owl:equivalentClass telcrm:SubscriberRelationship .
legacy:subscribers owl:equivalentClass telcrm:Subscriber .
legacy:devices owl:equivalentClass telcrm:Device .
legacy:billing_account_references owl:equivalentClass telcrm:BillingAccountReference .
legacy:charging_account_references owl:equivalentClass telcrm:ChargingAccountReference .
legacy:acquisition_journeys owl:equivalentClass telcrm:AcquisitionJourney .
legacy:upgrade_journeys owl:equivalentClass telcrm:UpgradeJourney .
legacy:portability_journeys owl:equivalentClass telcrm:PortabilityJourney .
legacy:dealer_referrals owl:equivalentClass telcrm:DealerReferral .
legacy:service_order_handoffs owl:equivalentClass telcrm:ServiceOrderHandoff .
legacy:renewal_journeys owl:equivalentClass telcrm:ContractRenewalJourney .
legacy:retention_journeys owl:equivalentClass telcrm:RetentionJourney .
legacy:billing_enquiries owl:equivalentClass telcrm:BillingEnquiry .
legacy:balance_enquiries owl:equivalentClass telcrm:BalanceEnquiry .
legacy:service_enquiries owl:equivalentClass telcrm:ServiceEnquiry .
legacy:provisioning_enquiries owl:equivalentClass telcrm:ProvisioningEnquiry .
legacy:network_experience_cases owl:equivalentClass telcrm:NetworkExperienceCase .
legacy:risk_referrals owl:equivalentClass telcrm:FraudOrRiskReferral .
legacy:interaction_outcomes owl:equivalentClass telcrm:InteractionOutcome .
legacy:enterprise_relationships owl:equivalentClass telcrm:EnterpriseRelationship .
legacy:partner_relationships owl:equivalentClass telcrm:PartnerRelationship .
legacy:service_sites owl:equivalentClass telcrm:ServiceSite .
legacy:opportunities owl:equivalentClass crm:Opportunity .
legacy:campaign_members owl:equivalentClass crm:CampaignMember .

#################################################################
# Authoritative operational class mappings
#################################################################

legacy:customer_accounts owl:equivalentClass sub:CustomerAccount .
legacy:subscriptions owl:equivalentClass sub:Subscription .
legacy:service_lines owl:equivalentClass sub:ServiceLine .
legacy:rate_plans owl:equivalentClass telcrm:RatePlan .
legacy:billing_accounts owl:equivalentClass bil:BillingAccount .
legacy:invoices owl:equivalentClass bil:Invoice .
legacy:charging_accounts owl:equivalentClass chg:ChargingAccount .
legacy:mobile_numbers owl:equivalentClass num:MobileNumber .
legacy:sim_profiles owl:equivalentClass num:SIMProfile .
legacy:porting_requests owl:equivalentClass num:PortingRequest .
legacy:service_instances owl:equivalentClass siv:ServiceInstance .
legacy:service_orders owl:equivalentClass prv:ServiceOrder .
legacy:fallout_cases owl:equivalentClass prv:FalloutCase .
legacy:customer_impacts owl:equivalentClass sam:CustomerImpact .
legacy:assurance_cases owl:equivalentClass sam:AssuranceCase .
legacy:investigations owl:equivalentClass raf:Investigation .
legacy:partners owl:equivalentClass prm:Partner .
legacy:wholesale_partners owl:equivalentClass wsp:WholesalePartner .
legacy:churn_scores owl:equivalentClass cvm:ChurnRisk .

#################################################################
# CRM telco fields
#################################################################

legacy:customer_party_id rdfs:subPropertyOf telcrm:customerPartyId .
legacy:party_role rdfs:subPropertyOf telcrm:partyRole .
legacy:identity_verified rdfs:subPropertyOf telcrm:identityVerified .
legacy:authority_type rdfs:subPropertyOf telcrm:authorityType .
legacy:authority_start rdfs:subPropertyOf telcrm:authorityStart .
legacy:authority_end rdfs:subPropertyOf telcrm:authorityEnd .
legacy:relationship_segment rdfs:subPropertyOf telcrm:relationshipSegment .
legacy:subscriber_id rdfs:subPropertyOf telcrm:subscriberId .
legacy:service_status rdfs:subPropertyOf telcrm:serviceStatus .
legacy:service_activated_at rdfs:subPropertyOf telcrm:activatedAt .
legacy:subscription_type rdfs:subPropertyOf telcrm:subscriptionType .
legacy:contract_end_date rdfs:subPropertyOf telcrm:contractEndDate .
legacy:plan_code rdfs:subPropertyOf telcrm:planCode .
legacy:plan_name rdfs:subPropertyOf telcrm:planName .
legacy:recurring_fee rdfs:subPropertyOf telcrm:recurringFee .
legacy:commitment_months rdfs:subPropertyOf telcrm:commitmentMonths .
legacy:device_identifier rdfs:subPropertyOf telcrm:deviceIdentifier .
legacy:device_type rdfs:subPropertyOf telcrm:deviceType .
legacy:device_model rdfs:subPropertyOf telcrm:deviceModel .
legacy:device_eligibility_date rdfs:subPropertyOf telcrm:eligibilityDate .
legacy:journey_status rdfs:subPropertyOf telcrm:journeyStatus .
legacy:journey_started_at rdfs:subPropertyOf telcrm:startedAt .
legacy:journey_completed_at rdfs:subPropertyOf telcrm:completedAt .
legacy:acquisition_channel rdfs:subPropertyOf telcrm:acquisitionChannel .
legacy:upgrade_reason rdfs:subPropertyOf telcrm:upgradeReason .
legacy:port_direction rdfs:subPropertyOf telcrm:direction .
legacy:handoff_at rdfs:subPropertyOf telcrm:handedOffAt .
legacy:handoff_status rdfs:subPropertyOf telcrm:handoffStatus .
legacy:retention_reason rdfs:subPropertyOf telcrm:retentionReason .
legacy:save_outcome rdfs:subPropertyOf telcrm:saveOutcome .
legacy:interaction_outcome_type rdfs:subPropertyOf telcrm:outcomeType .
legacy:interaction_outcome_at rdfs:subPropertyOf telcrm:outcomeAt .
legacy:interaction_outcome_value rdfs:subPropertyOf telcrm:outcomeValue .
legacy:site_name rdfs:subPropertyOf telcrm:siteName .
legacy:site_reference rdfs:subPropertyOf telcrm:siteReference .

#################################################################
# CRM-to-operational relationship mappings
#################################################################

legacy:relationship_customer_party_ref rdfs:subPropertyOf telcrm:relationshipWithCustomerParty ;
    rdfs:domain legacy:subscriber_relationships ; rdfs:range legacy:customer_parties .

legacy:relationship_authorised_contact_ref rdfs:subPropertyOf telcrm:hasAuthorisedContact ;
    rdfs:domain legacy:subscriber_relationships ; rdfs:range legacy:authorised_contacts .

legacy:relationship_customer_account_ref rdfs:subPropertyOf telcrm:ownsCustomerAccount ;
    rdfs:domain legacy:subscriber_relationships ; rdfs:range legacy:customer_accounts .

legacy:relationship_subscription_ref rdfs:subPropertyOf telcrm:coversSubscription ;
    rdfs:domain legacy:subscriber_relationships ; rdfs:range legacy:subscriptions .

legacy:subscription_subscriber_ref rdfs:subPropertyOf telcrm:activatesSubscriber ;
    rdfs:domain legacy:subscriptions ; rdfs:range legacy:subscribers .

legacy:subscription_rate_plan_ref rdfs:subPropertyOf telcrm:usesRatePlan ;
    rdfs:domain legacy:subscriptions ; rdfs:range legacy:rate_plans .

legacy:subscriber_mobile_number_ref rdfs:subPropertyOf telcrm:usesMobileNumber ;
    rdfs:domain legacy:subscribers ; rdfs:range legacy:mobile_numbers .

legacy:subscriber_sim_profile_ref rdfs:subPropertyOf telcrm:usesSimProfile ;
    rdfs:domain legacy:subscribers ; rdfs:range legacy:sim_profiles .

legacy:subscriber_device_ref rdfs:subPropertyOf telcrm:usesDevice ;
    rdfs:domain legacy:subscribers ; rdfs:range legacy:devices .

legacy:relationship_billing_account_ref rdfs:subPropertyOf telcrm:usesBillingAccount ;
    rdfs:domain legacy:subscriber_relationships ; rdfs:range legacy:billing_accounts .

legacy:relationship_charging_account_ref rdfs:subPropertyOf telcrm:usesChargingAccount ;
    rdfs:domain legacy:subscriber_relationships ; rdfs:range legacy:charging_accounts .

legacy:opportunity_subscription_ref rdfs:subPropertyOf telcrm:changesSubscription ;
    rdfs:domain legacy:opportunities ; rdfs:range legacy:subscriptions .

legacy:opportunity_rate_plan_ref rdfs:subPropertyOf telcrm:recommendsRatePlan ;
    rdfs:domain legacy:opportunities ; rdfs:range legacy:rate_plans .

legacy:opportunity_service_order_ref rdfs:subPropertyOf telcrm:createsServiceOrder ;
    rdfs:domain legacy:opportunities ; rdfs:range legacy:service_orders .

legacy:handoff_opportunity_ref rdfs:subPropertyOf telcrm:handoffForOpportunity ;
    rdfs:domain legacy:service_order_handoffs ; rdfs:range legacy:opportunities .

legacy:handoff_service_order_ref rdfs:subPropertyOf telcrm:handsOpportunityToServiceOrder ;
    rdfs:domain legacy:service_order_handoffs ; rdfs:range legacy:service_orders .

legacy:acquisition_campaign_member_ref rdfs:subPropertyOf telcrm:originatedFromCampaignMember ;
    rdfs:domain legacy:acquisition_journeys ; rdfs:range legacy:campaign_members .

legacy:acquisition_partner_ref rdfs:subPropertyOf telcrm:originatedFromDealer ;
    rdfs:domain legacy:acquisition_journeys ; rdfs:range legacy:partners .

legacy:acquisition_subscription_ref rdfs:subPropertyOf telcrm:createsSubscription ;
    rdfs:domain legacy:acquisition_journeys ; rdfs:range legacy:subscriptions .

legacy:portability_request_ref rdfs:subPropertyOf telcrm:tracksPortingRequest ;
    rdfs:domain legacy:portability_journeys ; rdfs:range legacy:porting_requests .

legacy:billing_enquiry_invoice_ref rdfs:subPropertyOf telcrm:concernsInvoice ;
    rdfs:domain legacy:billing_enquiries ; rdfs:range legacy:invoices .

legacy:balance_enquiry_charging_ref rdfs:subPropertyOf telcrm:concernsChargingAccount ;
    rdfs:domain legacy:balance_enquiries ; rdfs:range legacy:charging_accounts .

legacy:service_enquiry_instance_ref rdfs:subPropertyOf telcrm:concernsServiceInstance ;
    rdfs:domain legacy:service_enquiries ; rdfs:range legacy:service_instances .

legacy:provisioning_enquiry_fallout_ref rdfs:subPropertyOf telcrm:concernsFalloutCase ;
    rdfs:domain legacy:provisioning_enquiries ; rdfs:range legacy:fallout_cases .

legacy:network_case_impact_ref rdfs:subPropertyOf telcrm:concernsCustomerImpact ;
    rdfs:domain legacy:network_experience_cases ; rdfs:range legacy:customer_impacts .

legacy:network_case_assurance_ref rdfs:subPropertyOf telcrm:concernsAssuranceCase ;
    rdfs:domain legacy:network_experience_cases ; rdfs:range legacy:assurance_cases .

legacy:retention_churn_score_ref rdfs:subPropertyOf telcrm:informedByChurnRisk ;
    rdfs:domain legacy:retention_journeys ; rdfs:range legacy:churn_scores .

legacy:retention_opportunity_ref rdfs:subPropertyOf telcrm:producesOpportunity ;
    rdfs:domain legacy:retention_journeys ; rdfs:range legacy:opportunities .

legacy:risk_referral_investigation_ref rdfs:subPropertyOf telcrm:refersInvestigation ;
    rdfs:domain legacy:risk_referrals ; rdfs:range legacy:investigations .

legacy:partner_relationship_partner_ref rdfs:subPropertyOf telcrm:representsPartner ;
    rdfs:domain legacy:partner_relationships ; rdfs:range legacy:partners .

legacy:partner_relationship_wholesale_ref rdfs:subPropertyOf telcrm:representsWholesalePartner ;
    rdfs:domain legacy:partner_relationships ; rdfs:range legacy:wholesale_partners .

legacy:enterprise_relationship_site_ref rdfs:subPropertyOf telcrm:hasServiceSite ;
    rdfs:domain legacy:enterprise_relationships ; rdfs:range legacy:service_sites .

#################################################################
# Source validation
#################################################################

legacy:SubscriberRelationshipSourceShape a sh:NodeShape ;
    sh:targetClass legacy:subscriber_relationships ;
    sh:property [ sh:path legacy:relationship_customer_party_ref ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path legacy:relationship_customer_account_ref ; sh:minCount 1 ] ;
    sh:property [ sh:path legacy:relationship_subscription_ref ; sh:minCount 1 ] .

legacy:SubscriberSourceShape a sh:NodeShape ;
    sh:targetClass legacy:subscribers ;
    sh:property [ sh:path legacy:subscriber_id ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path legacy:service_status ; sh:datatype xsd:string ;
        sh:in ( "reserved" "pending_activation" "active" "suspended" "ceased" ) ] .

legacy:HandoffSourceShape a sh:NodeShape ;
    sh:targetClass legacy:service_order_handoffs ;
    sh:property [ sh:path legacy:handoff_opportunity_ref ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path legacy:handoff_service_order_ref ; sh:minCount 1 ; sh:maxCount 1 ] .

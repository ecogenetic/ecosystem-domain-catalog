@prefix : <https://ecosystemcode.com/ontology/crm#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix bfo:  <http://purl.obolibrary.org/obo/BFO_> .

<https://ecosystemcode.com/ontology/crm> a owl:Ontology ;
    rdfs:label "CRM Domain Ontology" ;
    rdfs:comment "Seed ontology for Customer Relationship Management: accounts, contacts, campaigns, leads, opportunities, quotes, contracts, forecasts, service cases, and activities." .

#################################################################
# Classes
#################################################################

:Account a owl:Class ;
    skos:prefLabel "Account" ;
    skos:altLabel "Customer Account", "Client", "Company" ;
    skos:definition "An organisation the business sells to or has a commercial relationship with." .

:Contact a owl:Class ;
    skos:prefLabel "Contact" ;
    skos:altLabel "Customer Contact", "Person of Interest" ;
    skos:definition "A person affiliated with an Account who participates in the buying process." .

:Lead a owl:Class ;
    skos:prefLabel "Lead" ;
    skos:altLabel "Prospect", "Inquiry" ;
    skos:definition "An unqualified prospect captured from marketing or outreach, not yet linked to a deal." .

:Opportunity a owl:Class ;
    skos:prefLabel "Opportunity" ;
    skos:altLabel "Deal", "Sales Opportunity" ;
    skos:definition "A potential deal with monetary value and an expected close date." .

:Pipeline a owl:Class ;
    skos:prefLabel "Pipeline" ;
    skos:altLabel "Sales Pipeline", "Stage Model" ;
    skos:definition "The ordered set of stages an Opportunity moves through toward close." .

:Activity a owl:Class ;
    skos:prefLabel "Activity" ;
    skos:altLabel "Interaction", "Touchpoint" ;
    skos:definition "A logged interaction such as a call, email, meeting, or note against a Contact, Opportunity, or Case." .

:Territory a owl:Class ;
    skos:prefLabel "Territory" ;
    skos:altLabel "Sales Territory", "Region", "Patch" ;
    skos:definition "A named market segment (geography, industry, or size band) that accounts are assigned to for coverage and quota purposes." .

:Campaign a owl:Class ;
    skos:prefLabel "Campaign" ;
    skos:altLabel "Marketing Campaign", "Marketing Initiative" ;
    skos:definition "A planned marketing initiative (event, email, ads, webinar) with a budget that generates and influences leads." .

:Product a owl:Class ;
    skos:prefLabel "Product" ;
    skos:altLabel "Catalog Item", "Offering", "Service" ;
    skos:definition "A sellable product or service in the catalog that opportunities and quotes reference." .

:Quote a owl:Class ;
    skos:prefLabel "Quote" ;
    skos:altLabel "Proposal", "Quotation" ;
    skos:definition "A priced, time-limited proposal presented to the customer for an opportunity." .

:QuoteLine a owl:Class ;
    skos:prefLabel "Quote Line" ;
    skos:altLabel "Quote Line Item", "Proposal Line" ;
    skos:definition "A single product line on a quote with quantity, unit price, and discount." .

:Contract a owl:Class ;
    skos:prefLabel "Contract" ;
    skos:altLabel "Agreement", "Order Form" ;
    skos:definition "The negotiated agreement that governs a won deal, with value, term, and renewal dates." .

:Forecast a owl:Class ;
    skos:prefLabel "Forecast" ;
    skos:altLabel "Sales Forecast", "Revenue Projection" ;
    skos:definition "A periodic projection of expected revenue for a territory, built from weighted open opportunities." .

:Case a owl:Class ;
    skos:prefLabel "Case" ;
    skos:altLabel "Ticket", "Service Request", "Complaint" ;
    skos:definition "A post-sale service request or complaint raised by a contact, tracked to resolution." .

:PipelineStage a owl:Class ;
    skos:prefLabel "Pipeline Stage" ;
    skos:altLabel "Sales Stage", "Deal Stage" ;
    skos:definition "One named, ordered stage within a pipeline; an opportunity sits at exactly one stage at a time." .

#################################################################
# Object properties
#################################################################

:belongsToAccount a owl:ObjectProperty ;
    rdfs:label "belongs to account" ;
    rdfs:domain :Contact ;
    rdfs:range  :Account ;
    skos:definition "Associates a contact with the account they work for." .

:pursuedWithAccount a owl:ObjectProperty ;
    rdfs:label "pursued with account" ;
    rdfs:domain :Opportunity ;
    rdfs:range  :Account ;
    skos:definition "The account an opportunity is being pursued with." .

:hasPrimaryContact a owl:ObjectProperty ;
    rdfs:label "has primary contact" ;
    rdfs:domain :Opportunity ;
    rdfs:range  :Contact ;
    skos:definition "The main contact person driving the deal on the customer side." .

:progressesThroughPipeline a owl:ObjectProperty ;
    rdfs:label "progresses through pipeline" ;
    rdfs:domain :Opportunity ;
    rdfs:range  :Pipeline ;
    skos:definition "The pipeline whose stages the opportunity moves through." .

:convertsToOpportunity a owl:ObjectProperty ;
    rdfs:label "converts to opportunity" ;
    rdfs:domain :Lead ;
    rdfs:range  :Opportunity ;
    skos:definition "Links a qualified lead to the opportunity it was converted into." .

:loggedAgainstOpportunity a owl:ObjectProperty ;
    rdfs:label "logged against opportunity" ;
    rdfs:domain :Activity ;
    rdfs:range  :Opportunity ;
    skos:definition "The opportunity an activity was recorded against." .

:involvesContact a owl:ObjectProperty ;
    rdfs:label "involves contact" ;
    rdfs:domain :Activity ;
    rdfs:range  :Contact ;
    skos:definition "The contact who took part in the activity." .

:assignedToTerritory a owl:ObjectProperty ;
    rdfs:label "assigned to territory" ;
    rdfs:domain :Account ;
    rdfs:range  :Territory ;
    skos:definition "The territory an account is assigned to for coverage and quota purposes." .

:generatesLead a owl:ObjectProperty ;
    rdfs:label "generates lead" ;
    rdfs:domain :Campaign ;
    rdfs:range  :Lead ;
    skos:definition "The leads captured as responses to a marketing campaign." .

:influencedByCampaign a owl:ObjectProperty ;
    rdfs:label "influenced by campaign" ;
    rdfs:domain :Opportunity ;
    rdfs:range  :Campaign ;
    skos:definition "The campaign credited with sourcing or influencing an opportunity." .

:includesProduct a owl:ObjectProperty ;
    rdfs:label "includes product" ;
    rdfs:domain :Opportunity ;
    rdfs:range  :Product ;
    skos:definition "The catalog products an opportunity is expected to sell." .

:quotesOpportunity a owl:ObjectProperty ;
    rdfs:label "quotes opportunity" ;
    rdfs:domain :Quote ;
    rdfs:range  :Opportunity ;
    skos:definition "The opportunity a quote prices a proposal for." .

:partOfQuote a owl:ObjectProperty ;
    rdfs:label "part of quote" ;
    rdfs:domain :QuoteLine ;
    rdfs:range  :Quote ;
    skos:definition "The quote a line belongs to." .

:forQuotedProduct a owl:ObjectProperty ;
    rdfs:label "for quoted product" ;
    rdfs:domain :QuoteLine ;
    rdfs:range  :Product ;
    skos:definition "The product priced on a quote line." .

:resultsFromOpportunity a owl:ObjectProperty ;
    rdfs:label "results from opportunity" ;
    rdfs:domain :Contract ;
    rdfs:range  :Opportunity ;
    skos:definition "The won opportunity a contract was created from." .

:governsAccount a owl:ObjectProperty ;
    rdfs:label "governs account" ;
    rdfs:domain :Contract ;
    rdfs:range  :Account ;
    skos:definition "The account whose commercial relationship the contract governs." .

:raisedByContact a owl:ObjectProperty ;
    rdfs:label "raised by contact" ;
    rdfs:domain :Case ;
    rdfs:range  :Contact ;
    skos:definition "The contact who raised the service case." .

:filedAgainstAccount a owl:ObjectProperty ;
    rdfs:label "filed against account" ;
    rdfs:domain :Case ;
    rdfs:range  :Account ;
    skos:definition "The account a service case is filed against." .

:aboutProduct a owl:ObjectProperty ;
    rdfs:label "about product" ;
    rdfs:domain :Case ;
    rdfs:range  :Product ;
    skos:definition "The product a service case concerns." .

:loggedAgainstCase a owl:ObjectProperty ;
    rdfs:label "logged against case" ;
    rdfs:domain :Activity ;
    rdfs:range  :Case ;
    skos:definition "The service case an activity was recorded against." .

:coversTerritory a owl:ObjectProperty ;
    rdfs:label "covers territory" ;
    rdfs:domain :Forecast ;
    rdfs:range  :Territory ;
    skos:definition "The territory whose expected revenue a forecast projects." .

:convertsToContact a owl:ObjectProperty ;
    rdfs:label "converts to contact" ;
    rdfs:domain :Lead ;
    rdfs:range  :Contact ;
    skos:definition "The contact record created when a qualified lead is converted." .

:convertsToAccount a owl:ObjectProperty ;
    rdfs:label "converts to account" ;
    rdfs:domain :Lead ;
    rdfs:range  :Account ;
    skos:definition "The new or matched account a converted lead is attached to." .

:atPipelineStage a owl:ObjectProperty ;
    rdfs:label "at pipeline stage" ;
    rdfs:domain :Opportunity ;
    rdfs:range  :PipelineStage ;
    skos:definition "The single pipeline stage the opportunity currently sits at." .

:partOfPipeline a owl:ObjectProperty ;
    rdfs:label "part of pipeline" ;
    rdfs:domain :PipelineStage ;
    rdfs:range  :Pipeline ;
    skos:definition "The pipeline this stage belongs to, in stage order." .

:renewsIntoOpportunity a owl:ObjectProperty ;
    rdfs:label "renews into opportunity" ;
    rdfs:domain :Contract ;
    rdfs:range  :Opportunity ;
    skos:definition "The renewal opportunity opened as the contract approaches its end date." .

#################################################################
# Datatype properties
#################################################################

:accountName a owl:DatatypeProperty ;
    rdfs:label "account name" ;
    rdfs:domain :Account ;
    rdfs:range  xsd:string .

:industry a owl:DatatypeProperty ;
    rdfs:label "industry" ;
    rdfs:domain :Account ;
    rdfs:range  xsd:string .

:annualRevenue a owl:DatatypeProperty ;
    rdfs:label "annual revenue" ;
    rdfs:domain :Account ;
    rdfs:range  xsd:decimal .

:fullName a owl:DatatypeProperty ;
    rdfs:label "full name" ;
    rdfs:domain :Contact ;
    rdfs:range  xsd:string .

:email a owl:DatatypeProperty ;
    rdfs:label "email" ;
    rdfs:domain :Contact ;
    rdfs:range  xsd:string .

:phone a owl:DatatypeProperty ;
    rdfs:label "phone" ;
    rdfs:domain :Contact ;
    rdfs:range  xsd:string .

:leadSource a owl:DatatypeProperty ;
    rdfs:label "lead source" ;
    rdfs:domain :Lead ;
    rdfs:range  xsd:string .

:capturedAt a owl:DatatypeProperty ;
    rdfs:label "captured at" ;
    rdfs:domain :Lead ;
    rdfs:range  xsd:dateTime .

:amount a owl:DatatypeProperty ;
    rdfs:label "amount" ;
    rdfs:domain :Opportunity ;
    rdfs:range  xsd:decimal .

:closeDate a owl:DatatypeProperty ;
    rdfs:label "close date" ;
    rdfs:domain :Opportunity ;
    rdfs:range  xsd:date .

:opportunityStatus a owl:DatatypeProperty ;
    rdfs:label "opportunity status" ;
    rdfs:domain :Opportunity ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the opportunity: lead, qualified, proposal, won, lost." .

:activityType a owl:DatatypeProperty ;
    rdfs:label "activity type" ;
    rdfs:domain :Activity ;
    rdfs:range  xsd:string .

:occurredAt a owl:DatatypeProperty ;
    rdfs:label "occurred at" ;
    rdfs:domain :Activity ;
    rdfs:range  xsd:dateTime .

:website a owl:DatatypeProperty ;
    rdfs:label "website" ;
    rdfs:domain :Account ;
    rdfs:range  xsd:string .

:accountType a owl:DatatypeProperty ;
    rdfs:label "account type" ;
    rdfs:domain :Account ;
    rdfs:range  xsd:string ;
    skos:definition "Classification of the account: prospect, customer, partner, or former customer." .

:employeeCount a owl:DatatypeProperty ;
    rdfs:label "employee count" ;
    rdfs:domain :Account ;
    rdfs:range  xsd:integer .

:jobTitle a owl:DatatypeProperty ;
    rdfs:label "job title" ;
    rdfs:domain :Contact ;
    rdfs:range  xsd:string .

:department a owl:DatatypeProperty ;
    rdfs:label "department" ;
    rdfs:domain :Contact ;
    rdfs:range  xsd:string .

:territoryName a owl:DatatypeProperty ;
    rdfs:label "territory name" ;
    rdfs:domain :Territory ;
    rdfs:range  xsd:string .

:region a owl:DatatypeProperty ;
    rdfs:label "region" ;
    rdfs:domain :Territory ;
    rdfs:range  xsd:string .

:campaignName a owl:DatatypeProperty ;
    rdfs:label "campaign name" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:string .

:campaignType a owl:DatatypeProperty ;
    rdfs:label "campaign type" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:string ;
    skos:definition "Kind of campaign: event, email, ads, webinar, content." .

:campaignStartDate a owl:DatatypeProperty ;
    rdfs:label "campaign start date" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:date .

:campaignEndDate a owl:DatatypeProperty ;
    rdfs:label "campaign end date" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:date .

:budgetedCost a owl:DatatypeProperty ;
    rdfs:label "budgeted cost" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:decimal .

:campaignStatus a owl:DatatypeProperty ;
    rdfs:label "campaign status" ;
    rdfs:domain :Campaign ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the campaign: planned, active, completed." .

:company a owl:DatatypeProperty ;
    rdfs:label "company" ;
    rdfs:domain :Lead ;
    rdfs:range  xsd:string .

:leadScore a owl:DatatypeProperty ;
    rdfs:label "lead score" ;
    rdfs:domain :Lead ;
    rdfs:range  xsd:integer ;
    skos:definition "Qualification score assigned by marketing based on fit and engagement." .

:leadStatus a owl:DatatypeProperty ;
    rdfs:label "lead status" ;
    rdfs:domain :Lead ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the lead: new, contacted, qualified, converted, disqualified." .

:opportunityName a owl:DatatypeProperty ;
    rdfs:label "opportunity name" ;
    rdfs:domain :Opportunity ;
    rdfs:range  xsd:string .

:probability a owl:DatatypeProperty ;
    rdfs:label "probability" ;
    rdfs:domain :Opportunity ;
    rdfs:range  xsd:decimal ;
    skos:definition "Estimated likelihood (0-1) that the opportunity closes won, used for forecast weighting." .

:pipelineName a owl:DatatypeProperty ;
    rdfs:label "pipeline name" ;
    rdfs:domain :Pipeline ;
    rdfs:range  xsd:string .

:stageCount a owl:DatatypeProperty ;
    rdfs:label "stage count" ;
    rdfs:domain :Pipeline ;
    rdfs:range  xsd:integer .

:productCode a owl:DatatypeProperty ;
    rdfs:label "product code" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:string .

:productName a owl:DatatypeProperty ;
    rdfs:label "product name" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:string .

:listPrice a owl:DatatypeProperty ;
    rdfs:label "list price" ;
    rdfs:domain :Product ;
    rdfs:range  xsd:decimal .

:quoteNumber a owl:DatatypeProperty ;
    rdfs:label "quote number" ;
    rdfs:domain :Quote ;
    rdfs:range  xsd:string .

:quoteDate a owl:DatatypeProperty ;
    rdfs:label "quote date" ;
    rdfs:domain :Quote ;
    rdfs:range  xsd:date .

:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until" ;
    rdfs:domain :Quote ;
    rdfs:range  xsd:date .

:quoteTotal a owl:DatatypeProperty ;
    rdfs:label "quote total" ;
    rdfs:domain :Quote ;
    rdfs:range  xsd:decimal .

:quoteStatus a owl:DatatypeProperty ;
    rdfs:label "quote status" ;
    rdfs:domain :Quote ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the quote: draft, presented, accepted, rejected, expired." .

:quotedQuantity a owl:DatatypeProperty ;
    rdfs:label "quoted quantity" ;
    rdfs:domain :QuoteLine ;
    rdfs:range  xsd:decimal .

:quotedUnitPrice a owl:DatatypeProperty ;
    rdfs:label "quoted unit price" ;
    rdfs:domain :QuoteLine ;
    rdfs:range  xsd:decimal .

:discountPercent a owl:DatatypeProperty ;
    rdfs:label "discount percent" ;
    rdfs:domain :QuoteLine ;
    rdfs:range  xsd:decimal .

:contractNumber a owl:DatatypeProperty ;
    rdfs:label "contract number" ;
    rdfs:domain :Contract ;
    rdfs:range  xsd:string .

:contractStart a owl:DatatypeProperty ;
    rdfs:label "contract start" ;
    rdfs:domain :Contract ;
    rdfs:range  xsd:date .

:contractEnd a owl:DatatypeProperty ;
    rdfs:label "contract end" ;
    rdfs:domain :Contract ;
    rdfs:range  xsd:date .

:contractValue a owl:DatatypeProperty ;
    rdfs:label "contract value" ;
    rdfs:domain :Contract ;
    rdfs:range  xsd:decimal .

:contractStatus a owl:DatatypeProperty ;
    rdfs:label "contract status" ;
    rdfs:domain :Contract ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the contract: draft, active, expired, terminated." .

:forecastPeriod a owl:DatatypeProperty ;
    rdfs:label "forecast period" ;
    rdfs:domain :Forecast ;
    rdfs:range  xsd:string .

:forecastAmount a owl:DatatypeProperty ;
    rdfs:label "forecast amount" ;
    rdfs:domain :Forecast ;
    rdfs:range  xsd:decimal .

:commitAmount a owl:DatatypeProperty ;
    rdfs:label "commit amount" ;
    rdfs:domain :Forecast ;
    rdfs:range  xsd:decimal .

:bestCaseAmount a owl:DatatypeProperty ;
    rdfs:label "best case amount" ;
    rdfs:domain :Forecast ;
    rdfs:range  xsd:decimal .

:caseNumber a owl:DatatypeProperty ;
    rdfs:label "case number" ;
    rdfs:domain :Case ;
    rdfs:range  xsd:string .

:subject a owl:DatatypeProperty ;
    rdfs:label "subject" ;
    rdfs:domain :Case ;
    rdfs:range  xsd:string .

:priority a owl:DatatypeProperty ;
    rdfs:label "priority" ;
    rdfs:domain :Case ;
    rdfs:range  xsd:string ;
    skos:definition "Urgency of the case: low, medium, high, critical." .

:openedAt a owl:DatatypeProperty ;
    rdfs:label "opened at" ;
    rdfs:domain :Case ;
    rdfs:range  xsd:dateTime .

:resolvedAt a owl:DatatypeProperty ;
    rdfs:label "resolved at" ;
    rdfs:domain :Case ;
    rdfs:range  xsd:dateTime .

:caseStatus a owl:DatatypeProperty ;
    rdfs:label "case status" ;
    rdfs:domain :Case ;
    rdfs:range  xsd:string ;
    skos:definition "Lifecycle state of the case: new, in_progress, waiting_on_customer, resolved, closed." .

:marketingOptIn a owl:DatatypeProperty ;
    rdfs:label "marketing opt in" ;
    rdfs:domain :Contact ;
    rdfs:range  xsd:boolean ;
    skos:definition "Whether the contact has consented to marketing outreach; gates campaign targeting." .

:preferredChannel a owl:DatatypeProperty ;
    rdfs:label "preferred channel" ;
    rdfs:domain :Contact ;
    rdfs:range  xsd:string ;
    skos:definition "The contact's preferred outreach channel: email, phone, sms, none." .

:stageName a owl:DatatypeProperty ;
    rdfs:label "stage name" ;
    rdfs:domain :PipelineStage ;
    rdfs:range  xsd:string .

:stageOrder a owl:DatatypeProperty ;
    rdfs:label "stage order" ;
    rdfs:domain :PipelineStage ;
    rdfs:range  xsd:integer .

:defaultProbability a owl:DatatypeProperty ;
    rdfs:label "default probability" ;
    rdfs:domain :PipelineStage ;
    rdfs:range  xsd:decimal ;
    skos:definition "The default win probability assigned to opportunities entering this stage, used for forecasting." .

:slaDueAt a owl:DatatypeProperty ;
    rdfs:label "sla due at" ;
    rdfs:domain :Case ;
    rdfs:range  xsd:dateTime ;
    skos:definition "The deadline by which the case must be resolved under the applicable service-level agreement." .

:escalated a owl:DatatypeProperty ;
    rdfs:label "escalated" ;
    rdfs:domain :Case ;
    rdfs:range  xsd:boolean .

#################################################################
# Roles (BFO role branch — bearer and permissions in the definition)
#################################################################

:SalesRepRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Sales Rep" ;
    skos:altLabel "Account Executive", "Sales Representative" ;
    skos:definition "Person role that captures leads, owns opportunities, builds quotes, and logs activities. Bearer: person. Permissions: Lead:read, Lead:write, Opportunity:read, Opportunity:write, Quote:read, Quote:write, Activity:read, Activity:write, Account:read, Contact:read, Product:read." .

:SalesManagerRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Sales Manager" ;
    skos:altLabel "Head of Sales" ;
    skos:definition "Person role that configures pipelines and territories, reviews forecasts, and approves discounts and closes. Bearer: person. Permissions: Pipeline:read, Pipeline:write, Territory:read, Territory:write, Forecast:read, Forecast:write, Opportunity:read, Quote:read, Account:read." .

:MarketingSpecialistRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Marketing Specialist" ;
    skos:altLabel "Campaign Manager", "Demand Generation Manager" ;
    skos:definition "Person role that plans campaigns, manages budgets, and routes generated leads to sales. Bearer: person. Permissions: Campaign:read, Campaign:write, Lead:read, Lead:write, Account:read, Contact:read." .

:ServiceAgentRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Service Agent" ;
    skos:altLabel "Support Agent", "Customer Service Representative" ;
    skos:definition "Person role that owns cases from intake to resolution and logs customer interactions. Bearer: person. Permissions: Case:read, Case:write, Activity:read, Activity:write, Account:read, Contact:read, Product:read." .

:ContractAdminRole a owl:Class ;
    rdfs:subClassOf bfo:0000023 ;
    skos:prefLabel "Contract Administrator" ;
    skos:altLabel "Deal Desk Analyst", "Commercial Operations" ;
    skos:definition "Person role that drafts and administers contracts for won deals and tracks renewals. Bearer: person. Permissions: Contract:read, Contract:write, Opportunity:read, Account:read." .


#################################################################
# Party, relationship, provenance, and commercial execution
#################################################################

:Party a owl:Class ;
    skos:prefLabel "Party" ;
    skos:altLabel "Business Party" ;
    skos:definition "A person or organisation participating in a prospect, customer, partner, or other business relationship." .

:Person a owl:Class ;
    rdfs:subClassOf :Party ;
    skos:prefLabel "Person" ;
    skos:altLabel "Individual" ;
    skos:definition "An individual party who may be a customer, prospect, contact, or representative." .

:Organisation a owl:Class ;
    rdfs:subClassOf :Party ;
    skos:prefLabel "Organisation" ;
    skos:altLabel "Organization", "Legal Entity" ;
    skos:definition "An organisational party such as a company, public body, partnership, or non-profit." .

:Account rdfs:subClassOf :Organisation .
:Contact rdfs:subClassOf :Person .

:CustomerRelationship a owl:Class ;
    skos:prefLabel "Customer Relationship" ;
    skos:altLabel "CRM Relationship", "Client Relationship" ;
    skos:definition "The managed commercial relationship between the enterprise and a customer party, distinct from the party and from any financial account." .

:Assignment a owl:Class ;
    skos:prefLabel "Assignment" ;
    skos:altLabel "Ownership Assignment", "Work Allocation" ;
    skos:definition "A dated allocation of a CRM record to a responsible user or team." .

:ConsentRecord a owl:Class ;
    skos:prefLabel "Consent Record" ;
    skos:altLabel "Marketing Consent", "Communication Permission" ;
    skos:definition "Auditable permission or refusal for a party to be contacted for a stated purpose through a channel." .

:CampaignMember a owl:Class ;
    skos:prefLabel "Campaign Member" ;
    skos:altLabel "Campaign Participant", "Audience Member" ;
    skos:definition "One party's participation in a campaign, including targeting, delivery, response, and suppression status." .

:LeadConversion a owl:Class ;
    skos:prefLabel "Lead Conversion" ;
    skos:altLabel "Qualification Conversion" ;
    skos:definition "The auditable event that qualifies a lead and resolves or creates the associated party, customer relationship, and opportunity." .

:OpportunityLine a owl:Class ;
    skos:prefLabel "Opportunity Line" ;
    skos:altLabel "Opportunity Product", "Deal Line" ;
    skos:definition "One product included in an opportunity with expected quantity, price, revenue, and term." .

:StageTransition a owl:Class ;
    skos:prefLabel "Stage Transition" ;
    skos:altLabel "Opportunity Stage History", "Pipeline Movement" ;
    skos:definition "The history record of an opportunity moving from one pipeline stage to another." .

:relatesToParty a owl:ObjectProperty ;
    rdfs:label "relates to party" ;
    rdfs:domain :CustomerRelationship ;
    rdfs:range :Party .

:pursuedForRelationship a owl:ObjectProperty ;
    rdfs:label "pursued for relationship" ;
    rdfs:domain :Opportunity ;
    rdfs:range :CustomerRelationship .

:governsRelationship a owl:ObjectProperty ;
    rdfs:label "governs relationship" ;
    rdfs:domain :Contract ;
    rdfs:range :CustomerRelationship .

:hasCampaignMember a owl:ObjectProperty ;

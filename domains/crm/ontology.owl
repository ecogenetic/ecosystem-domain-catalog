  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#occurredAt">
    <rdfs:label>occurred at</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Activity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#relationshipType">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#CustomerRelationship"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#ContractAdminRole">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <skos:prefLabel>Contract Administrator</skos:prefLabel>
    <skos:altLabel>Deal Desk Analyst</skos:altLabel>
    <skos:altLabel>Commercial Operations</skos:altLabel>
    <skos:definition>Person role that drafts and administers contracts for won deals and tracks renewals. Bearer: person. Permissions: Contract:read, Contract:write, Opportunity:read, Account:read.</skos:definition>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#registrationNumber">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Organisation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#loggedAgainstCase">
    <rdfs:label>logged against case</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Activity"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Case"/>
    <skos:definition>The service case an activity was recorded against.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#consentWithdrawnAt">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#ConsentRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#email">
    <rdfs:label>email</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#organisationName">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Organisation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#hasCampaignMember">
    <rdfs:label>has campaign member</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Campaign"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#CampaignMember"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#progressesThroughPipeline">
    <rdfs:label>progresses through pipeline</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Pipeline"/>
    <skos:definition>The pipeline whose stages the opportunity moves through.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#consentCapturedAt">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#ConsentRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#hasOpportunityLine">
    <rdfs:label>has opportunity line</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#OpportunityLine"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#memberStatus">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#CampaignMember"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#transitionReason">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#StageTransition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#expectedUnitPrice">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#OpportunityLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#forecastAmount">
    <rdfs:label>forecast amount</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Forecast"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#quotesOpportunity">
    <rdfs:label>quotes opportunity</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Quote"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <skos:definition>The opportunity a quote prices a proposal for.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#relationshipNumber">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#CustomerRelationship"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#expectedRevenue">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#OpportunityLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#assignmentEndedAt">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Assignment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#campaignType">
    <rdfs:label>campaign type</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Campaign"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Kind of campaign: event, email, ads, webinar, content.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#discountPercent">
    <rdfs:label>discount percent</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#QuoteLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#leadScore">
    <rdfs:label>lead score</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Lead"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition>Qualification score assigned by marketing based on fit and engagement.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#raisedByParty">
    <rdfs:label>raised by party</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Case"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Party"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#pursuedWithAccount">
    <rdfs:label>pursued with account</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Account"/>
    <skos:definition>The account an opportunity is being pursued with.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#governsRelationship">
    <rdfs:label>governs relationship</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contract"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#CustomerRelationship"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#matchedExistingParty">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#LeadConversion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#escalated">
    <rdfs:label>escalated</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Case"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Person">
    <rdfs:subClassOf rdf:resource="https://ecosystemcode.com/ontology/crm#Party"/>
    <skos:prefLabel>Person</skos:prefLabel>
    <skos:altLabel>Individual</skos:altLabel>
    <skos:definition>An individual party who may be a customer, prospect, contact, or representative.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Activity">
    <skos:prefLabel>Activity</skos:prefLabel>
    <skos:altLabel>Interaction</skos:altLabel>
    <skos:altLabel>Touchpoint</skos:altLabel>
    <skos:definition>A logged interaction such as a call, email, meeting, or note against a Contact, Opportunity, or Case.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Territory">
    <skos:prefLabel>Territory</skos:prefLabel>
    <skos:altLabel>Sales Territory</skos:altLabel>
    <skos:altLabel>Region</skos:altLabel>
    <skos:altLabel>Patch</skos:altLabel>
    <skos:definition>A named market segment (geography, industry, or size band) that accounts are assigned to for coverage and quota purposes.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Assignment">
    <skos:prefLabel>Assignment</skos:prefLabel>
    <skos:altLabel>Ownership Assignment</skos:altLabel>
    <skos:altLabel>Work Allocation</skos:altLabel>
    <skos:definition>A dated allocation of a CRM record to a responsible user or team.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Forecast">
    <skos:prefLabel>Forecast</skos:prefLabel>
    <skos:altLabel>Sales Forecast</skos:altLabel>
    <skos:altLabel>Revenue Projection</skos:altLabel>
    <skos:definition>A periodic projection of expected revenue for a territory, built from weighted open opportunities.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#CampaignMember">
    <skos:prefLabel>Campaign Member</skos:prefLabel>
    <skos:altLabel>Campaign Participant</skos:altLabel>
    <skos:altLabel>Audience Member</skos:altLabel>
    <skos:definition>One party's participation in a campaign, including targeting, delivery, response, and suppression status.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#OpportunityLine">
    <skos:prefLabel>Opportunity Line</skos:prefLabel>
    <skos:altLabel>Opportunity Product</skos:altLabel>
    <skos:altLabel>Deal Line</skos:altLabel>
    <skos:definition>One product included in an opportunity with expected quantity, price, revenue, and term.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#PipelineStage">
    <skos:prefLabel>Pipeline Stage</skos:prefLabel>
    <skos:altLabel>Sales Stage</skos:altLabel>
    <skos:altLabel>Deal Stage</skos:altLabel>
    <skos:definition>One named, ordered stage within a pipeline; an opportunity sits at exactly one stage at a time.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Case">
    <skos:prefLabel>Case</skos:prefLabel>
    <skos:altLabel>Ticket</skos:altLabel>
    <skos:altLabel>Service Request</skos:altLabel>
    <skos:altLabel>Complaint</skos:altLabel>
    <skos:definition>A post-sale service request or complaint raised by a contact, tracked to resolution.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Product">
    <skos:prefLabel>Product</skos:prefLabel>
    <skos:altLabel>Catalog Item</skos:altLabel>
    <skos:altLabel>Offering</skos:altLabel>
    <skos:altLabel>Service</skos:altLabel>
    <skos:definition>A sellable product or service in the catalog that opportunities and quotes reference.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Contract">
    <skos:prefLabel>Contract</skos:prefLabel>
    <skos:altLabel>Agreement</skos:altLabel>
    <skos:altLabel>Order Form</skos:altLabel>
    <skos:definition>The negotiated agreement that governs a won deal, with value, term, and renewal dates.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Lead">
    <skos:prefLabel>Lead</skos:prefLabel>
    <skos:altLabel>Prospect</skos:altLabel>
    <skos:altLabel>Inquiry</skos:altLabel>
    <skos:definition>An unqualified prospect captured from marketing or outreach, not yet linked to a deal.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Party">
    <skos:prefLabel>Party</skos:prefLabel>
    <skos:altLabel>Business Party</skos:altLabel>
    <skos:definition>A person or organisation participating in a prospect, customer, partner, or other business relationship.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#CustomerRelationship">
    <skos:prefLabel>Customer Relationship</skos:prefLabel>
    <skos:altLabel>CRM Relationship</skos:altLabel>
    <skos:altLabel>Client Relationship</skos:altLabel>
    <skos:definition>The managed commercial relationship between the enterprise and a customer party, distinct from the party and from any financial account.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#QuoteLine">
    <skos:prefLabel>Quote Line</skos:prefLabel>
    <skos:altLabel>Quote Line Item</skos:altLabel>
    <skos:altLabel>Proposal Line</skos:altLabel>
    <skos:definition>A single product line on a quote with quantity, unit price, and discount.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Opportunity">
    <skos:prefLabel>Opportunity</skos:prefLabel>
    <skos:altLabel>Deal</skos:altLabel>
    <skos:altLabel>Sales Opportunity</skos:altLabel>
    <skos:definition>A potential deal with monetary value and an expected close date.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Organisation">
    <rdfs:subClassOf rdf:resource="https://ecosystemcode.com/ontology/crm#Party"/>
    <skos:prefLabel>Organisation</skos:prefLabel>
    <skos:altLabel>Organization</skos:altLabel>
    <skos:altLabel>Legal Entity</skos:altLabel>
    <skos:definition>An organisational party such as a company, public body, partnership, or non-profit.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#LeadConversion">
    <skos:prefLabel>Lead Conversion</skos:prefLabel>
    <skos:altLabel>Qualification Conversion</skos:altLabel>
    <skos:definition>The auditable event that qualifies a lead and resolves or creates the associated party, customer relationship, and opportunity.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Campaign">
    <skos:prefLabel>Campaign</skos:prefLabel>
    <skos:altLabel>Marketing Campaign</skos:altLabel>
    <skos:altLabel>Marketing Initiative</skos:altLabel>
    <skos:definition>A planned marketing initiative (event, email, ads, webinar) with a budget that generates and influences leads.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Pipeline">
    <skos:prefLabel>Pipeline</skos:prefLabel>
    <skos:altLabel>Sales Pipeline</skos:altLabel>
    <skos:altLabel>Stage Model</skos:altLabel>
    <skos:definition>The ordered set of stages an Opportunity moves through toward close.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Account">
    <skos:prefLabel>Account</skos:prefLabel>
    <skos:altLabel>Customer Account</skos:altLabel>
    <skos:altLabel>Client</skos:altLabel>
    <skos:altLabel>Company</skos:altLabel>
    <skos:definition>An organisation the business sells to or has a commercial relationship with.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://ecosystemcode.com/ontology/crm#Organisation"/>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Quote">
    <skos:prefLabel>Quote</skos:prefLabel>
    <skos:altLabel>Proposal</skos:altLabel>
    <skos:altLabel>Quotation</skos:altLabel>
    <skos:definition>A priced, time-limited proposal presented to the customer for an opportunity.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#StageTransition">
    <skos:prefLabel>Stage Transition</skos:prefLabel>
    <skos:altLabel>Opportunity Stage History</skos:altLabel>
    <skos:altLabel>Pipeline Movement</skos:altLabel>
    <skos:definition>The history record of an opportunity moving from one pipeline stage to another.</skos:definition>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#Contact">
    <skos:prefLabel>Contact</skos:prefLabel>
    <skos:altLabel>Customer Contact</skos:altLabel>
    <skos:altLabel>Person of Interest</skos:altLabel>
    <skos:definition>A person affiliated with an Account who participates in the buying process.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://ecosystemcode.com/ontology/crm#Person"/>
  </owl:Class>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#ConsentRecord">
    <skos:prefLabel>Consent Record</skos:prefLabel>
    <skos:altLabel>Marketing Consent</skos:altLabel>
    <skos:altLabel>Communication Permission</skos:altLabel>
    <skos:definition>Auditable permission or refusal for a party to be contacted for a stated purpose through a channel.</skos:definition>
  </owl:Class>
</rdf:RDF>

<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:skos="http://www.w3.org/2004/02/skos/core#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#involvesParty">
    <rdfs:label>involves party</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Activity"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Party"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#campaignName">
    <rdfs:label>campaign name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Campaign"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#convertsToContact">
    <rdfs:label>converts to contact</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Lead"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Contact"/>
    <skos:definition>The contact record created when a qualified lead is converted.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#forecastPeriod">
    <rdfs:label>forecast period</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Forecast"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#fullName">
    <rdfs:label>full name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#commitAmount">
    <rdfs:label>commit amount</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Forecast"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#marketingOptIn">
    <rdfs:label>marketing opt in</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <skos:definition>Whether the contact has consented to marketing outreach; gates campaign targeting.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#forOpportunityProduct">
    <rdfs:label>for opportunity product</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#OpportunityLine"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Product"/>
  </owl:ObjectProperty>
  <owl:Ontology rdf:about="https://ecosystemcode.com/ontology/crm">
    <rdfs:label>CRM Domain Ontology</rdfs:label>
    <rdfs:comment>Seed ontology for Customer Relationship Management: accounts, contacts, campaigns, leads, opportunities, quotes, contracts, forecasts, service cases, and activities.</rdfs:comment>
  </owl:Ontology>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#listPrice">
    <rdfs:label>list price</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#productCode">
    <rdfs:label>product code</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#convertsLead">
    <rdfs:label>converts lead</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#LeadConversion"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Lead"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#capturedAt">
    <rdfs:label>captured at</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Lead"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#region">
    <rdfs:label>region</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Territory"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#validUntil">
    <rdfs:label>valid until</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Quote"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#consentPurpose">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#ConsentRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#SalesRepRole">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <skos:prefLabel>Sales Rep</skos:prefLabel>
    <skos:altLabel>Account Executive</skos:altLabel>
    <skos:altLabel>Sales Representative</skos:altLabel>
    <skos:definition>Person role that captures leads, owns opportunities, builds quotes, and logs activities. Bearer: person. Permissions: Lead:read, Lead:write, Opportunity:read, Opportunity:write, Quote:read, Quote:write, Activity:read, Activity:write, Account:read, Contact:read, Product:read.</skos:definition>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#assigneeRef">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Assignment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#assignedToTerritory">
    <rdfs:label>assigned to territory</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Account"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Territory"/>
    <skos:definition>The territory an account is assigned to for coverage and quota purposes.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#contractStart">
    <rdfs:label>contract start</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#governsAccount">
    <rdfs:label>governs account</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contract"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Account"/>
    <skos:definition>The account whose commercial relationship the contract governs.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#defaultProbability">
    <rdfs:label>default probability</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#PipelineStage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:definition>The default win probability assigned to opportunities entering this stage, used for forecasting.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#accountType">
    <rdfs:label>account type</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Account"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Classification of the account: prospect, customer, partner, or former customer.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#assignsOpportunity">
    <rdfs:label>assigns opportunity</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Assignment"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#forQuotedProduct">
    <rdfs:label>for quoted product</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#QuoteLine"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Product"/>
    <skos:definition>The product priced on a quote line.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#industry">
    <rdfs:label>industry</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Account"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#accountName">
    <rdfs:label>account name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Account"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#opportunityQuantity">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#OpportunityLine"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#convertsToOpportunity">
    <rdfs:label>converts to opportunity</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Lead"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <skos:definition>Links a qualified lead to the opportunity it was converted into.</skos:definition>
  </owl:ObjectProperty>
  <owl:Class rdf:about="https://ecosystemcode.com/ontology/crm#ServiceAgentRole">
    <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
    <skos:prefLabel>Service Agent</skos:prefLabel>
    <skos:altLabel>Support Agent</skos:altLabel>
    <skos:altLabel>Customer Service Representative</skos:altLabel>
    <skos:definition>Person role that owns cases from intake to resolution and logs customer interactions. Bearer: person. Permissions: Case:read, Case:write, Activity:read, Activity:write, Account:read, Contact:read, Product:read.</skos:definition>
  </owl:Class>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#contractValue">
    <rdfs:label>contract value</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#pipelineName">
    <rdfs:label>pipeline name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Pipeline"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#generatesLead">
    <rdfs:label>generates lead</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Campaign"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Lead"/>
    <skos:definition>The leads captured as responses to a marketing campaign.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#department">
    <rdfs:label>department</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#budgetedCost">
    <rdfs:label>budgeted cost</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Campaign"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#partyExternalRef">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Party"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#contractStatus">
    <rdfs:label>contract status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the contract: draft, active, expired, terminated.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#leadSource">
    <rdfs:label>lead source</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Lead"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#closeDate">
    <rdfs:label>close date</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#leadStatus">
    <rdfs:label>lead status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Lead"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the lead: new, contacted, qualified, converted, disqualified.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#convertsToAccount">
    <rdfs:label>converts to account</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Lead"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Account"/>
    <skos:definition>The new or matched account a converted lead is attached to.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#quoteStatus">
    <rdfs:label>quote status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Quote"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the quote: draft, presented, accepted, rejected, expired.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#hasPrimaryContact">
    <rdfs:label>has primary contact</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Contact"/>
    <skos:definition>The main contact person driving the deal on the customer side.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#involvesContact">
    <rdfs:label>involves contact</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Activity"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Contact"/>
    <skos:definition>The contact who took part in the activity.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#campaignStatus">
    <rdfs:label>campaign status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Campaign"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the campaign: planned, active, completed.</skos:definition>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#bestCaseAmount">
    <rdfs:label>best case amount</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Forecast"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#partOfQuote">
    <rdfs:label>part of quote</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#QuoteLine"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Quote"/>
    <skos:definition>The quote a line belongs to.</skos:definition>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#atPipelineStage">
    <rdfs:label>at pipeline stage</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#PipelineStage"/>
    <skos:definition>The single pipeline stage the opportunity currently sits at.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#caseNumber">
    <rdfs:label>case number</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Case"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#toPipelineStage">
    <rdfs:label>to pipeline stage</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#StageTransition"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#PipelineStage"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#representsParty">
    <rdfs:label>represents party</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#CampaignMember"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Party"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#caseStatus">
    <rdfs:label>case status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Case"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the case: new, in_progress, waiting_on_customer, resolved, closed.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#resultsFromOpportunity">
    <rdfs:label>results from opportunity</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contract"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <skos:definition>The won opportunity a contract was created from.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#opportunityStatus">
    <rdfs:label>opportunity status</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <skos:definition>Lifecycle state of the opportunity: lead, qualified, proposal, won, lost.</skos:definition>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#pursuedForRelationship">
    <rdfs:label>pursued for relationship</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#CustomerRelationship"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#conversionOutcome">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#LeadConversion"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#contractEnd">
    <rdfs:label>contract end</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#productName">
    <rdfs:label>product name</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Product"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#jobTitle">
    <rdfs:label>job title</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:ObjectProperty rdf:about="https://ecosystemcode.com/ontology/crm#renewsIntoOpportunity">
    <rdfs:label>renews into opportunity</rdfs:label>
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#Contract"/>
    <rdfs:range rdf:resource="https://ecosystemcode.com/ontology/crm#Opportunity"/>
    <skos:definition>The renewal opportunity opened as the contract approaches its end date.</skos:definition>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#targetedAt">
    <rdfs:domain rdf:resource="https://ecosystemcode.com/ontology/crm#CampaignMember"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://ecosystemcode.com/ontology/crm#territoryName">

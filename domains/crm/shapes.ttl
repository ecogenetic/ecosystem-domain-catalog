@prefix :    <https://ecosystemcode.com/ontology/crm#> .
@prefix sh:  <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:AccountShape a sh:NodeShape ;
    sh:targetClass :Account ;
    sh:property [
        sh:path :accountName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

:ContactShape a sh:NodeShape ;
    sh:targetClass :Contact ;
    sh:property [
        sh:path :belongsToAccount ;
        sh:class :Account ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :fullName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

:LeadShape a sh:NodeShape ;
    sh:targetClass :Lead ;
    sh:property [
        sh:path :leadSource ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :leadStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "new" "contacted" "qualified" "converted" "disqualified" ) ;
    ] .

:OpportunityShape a sh:NodeShape ;
    sh:targetClass :Opportunity ;
    sh:property [
        sh:path :pursuedWithAccount ;
        sh:class :Account ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :amount ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :opportunityStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "lead" "qualified" "proposal" "won" "lost" ) ;
    ] .

:PipelineShape a sh:NodeShape ;
    sh:targetClass :Pipeline .

:ActivityShape a sh:NodeShape ;
    sh:targetClass :Activity ;
    sh:property [
        sh:path :activityType ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :occurredAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
    ] .

:CampaignShape a sh:NodeShape ;
    sh:targetClass :Campaign ;
    sh:property [
        sh:path :campaignName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :campaignStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "planned" "active" "completed" ) ;
    ] .

:ProductShape a sh:NodeShape ;
    sh:targetClass :Product ;
    sh:property [
        sh:path :productCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :productName ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] .

:QuoteShape a sh:NodeShape ;
    sh:targetClass :Quote ;
    sh:property [
        sh:path :quotesOpportunity ;
        sh:class :Opportunity ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :quoteNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :quoteStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "draft" "presented" "accepted" "rejected" "expired" ) ;
    ] .

:ContractShape a sh:NodeShape ;
    sh:targetClass :Contract ;
    sh:property [
        sh:path :governsAccount ;
        sh:class :Account ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :contractNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :contractStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "draft" "active" "expired" "terminated" ) ;
    ] .

:CaseShape a sh:NodeShape ;
    sh:targetClass :Case ;
    sh:property [
        sh:path :raisedByContact ;
        sh:class :Contact ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :caseNumber ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path :caseStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "new" "in_progress" "waiting_on_customer" "resolved" "closed" ) ;
    ] .


:CustomerRelationshipShape a sh:NodeShape ;
    sh:targetClass :CustomerRelationship ;
    sh:property [ sh:path :relationshipNumber ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :relatesToParty ; sh:class :Party ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :relationshipStatus ; sh:datatype xsd:string ; sh:minCount 1 ;
        sh:in ( "prospect" "active" "dormant" "ended" ) ] .

:CampaignMemberShape a sh:NodeShape ;
    sh:targetClass :CampaignMember ;
    sh:property [ sh:path :representsParty ; sh:class :Party ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :memberStatus ; sh:datatype xsd:string ; sh:minCount 1 ;
        sh:in ( "targeted" "delivered" "responded" "no_response" "suppressed" ) ] .

:LeadConversionShape a sh:NodeShape ;
    sh:targetClass :LeadConversion ;
    sh:property [ sh:path :convertsLead ; sh:class :Lead ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :resolvesToParty ; sh:class :Party ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :convertedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] .

:OpportunityLineShape a sh:NodeShape ;
    sh:targetClass :OpportunityLine ;
    sh:property [ sh:path :forOpportunityProduct ; sh:class :Product ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :opportunityQuantity ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path :expectedRevenue ; sh:datatype xsd:decimal ; sh:minInclusive 0 ] .

:PipelineStageShape a sh:NodeShape ;
    sh:targetClass :PipelineStage ;
    sh:property [ sh:path :partOfPipeline ; sh:class :Pipeline ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :stageOrder ; sh:datatype xsd:integer ; sh:minCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path :defaultProbability ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] .

:StageTransitionShape a sh:NodeShape ;
    sh:targetClass :StageTransition ;
    sh:property [ sh:path :recordsOpportunity ; sh:class :Opportunity ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :toPipelineStage ; sh:class :PipelineStage ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :transitionedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ; sh:maxCount 1 ] .

:ConsentRecordShape a sh:NodeShape ;
    sh:targetClass :ConsentRecord ;
    sh:property [ sh:path :recordsConsentFor ; sh:class :Party ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :consentPurpose ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path :consentChannel ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path :consentStatus ; sh:datatype xsd:string ; sh:minCount 1 ;
        sh:in ( "captured" "active" "withdrawn" "expired" ) ] .

:AssignmentShape a sh:NodeShape ;
    sh:targetClass :Assignment ;
    sh:property [ sh:path :assigneeRef ; sh:datatype xsd:string ; sh:minCount 1 ] ;
    sh:property [ sh:path :assignedAt ; sh:datatype xsd:dateTime ; sh:minCount 1 ] .

# Strengthen existing commercial constraints.
:OpportunityShape
    sh:property [ sh:path :atPipelineStage ; sh:class :PipelineStage ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :probability ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] .

:QuoteLineShape a sh:NodeShape ;
    sh:targetClass :QuoteLine ;
    sh:property [ sh:path :partOfQuote ; sh:class :Quote ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :forQuotedProduct ; sh:class :Product ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path :quotedQuantity ; sh:datatype xsd:decimal ; sh:minCount 1 ; sh:minInclusive 0 ] ;
    sh:property [ sh:path :discountPercent ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 100 ] .
